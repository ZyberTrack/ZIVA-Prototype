@inherits LayoutComponentBase

@code {
    private bool isNavOpen = true;

    void ToggleNav()
    {
        isNavOpen = !isNavOpen;
    }
}

<div class="page">

    <button class="nav-toggle" @onclick="ToggleNav">
        ☰
    </button>

    <div class="sidebar @(isNavOpen ? "open" : "closed")">
        <NavMenu />
    </div>

    <main class="@(isNavOpen ? "main-shift" : "main-full")">
        <article class="content px-4">
            <CascadingValue Value="isNavOpen">
                @Body
            </CascadingValue>
        </article>
    </main>
</div>
