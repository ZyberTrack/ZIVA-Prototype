@page "/DataImport"
@inject NavigationManager NavigationManager
@using ZIVA_Prototype.Services;
@using Microsoft.Maui.Storage;
@using ZIVA_Prototype.Services.Import;
@using ZIVA_Prototype.Services.Timeline;
@inject HistoryImportService HistoryImportService
@inject CookieImportService CookieImportService
@inject WebDataAutofillImportService AutofillService
@inject TimelineStateService State
@inject PersistStateService PersistService
@inject ChromeProfileLoader Loader
@using ZIVA_Prototype.Components.Models.Timeline;
@using ZIVA_Prototype.Configuration;

@code {

    string? CurrentProfilePath; // Current folder Path

    bool ShowRangeSelection = false;

    bool IsImporting = false;

    private string _selectedProfile = "30";

    private int SelectedImportDays = TimelineConstants.MaxImportDays;

    //private const int MaxImportDays = 7;

    private string? ErrorMessage;

    DateTime MinHistory;
    DateTime MaxHistory;

    DateTime SelectedFrom;
    DateTime SelectedTo;


    private async Task ImportChromeProfile()
    {
        ErrorMessage = null;

        var folderPath = await SelectProfileFolderFromFile();

        if (string.IsNullOrWhiteSpace(folderPath))
            return;

        CurrentProfilePath = folderPath;

        var historyFile = Directory
            .GetFiles(folderPath, "History", SearchOption.AllDirectories)
            .FirstOrDefault();

        if (historyFile == null)
        {
            ErrorMessage = "Keine Chromium-History-Datenbank gefunden.";
            return;
        }

        var range =
            await HistoryImportService.GetHistoryRangeAsync(historyFile);

        // Profil ist bereits klein genug -> direkt importieren
        if (range.TotalDays <= TimelineConstants.MaxImportDays)
        {
            IsImporting = true;
            StateHasChanged();

            try
            {
                await Loader.LoadProfileAsync(folderPath);

                await PersistService.PersistStateAsync(State);

                ShowRangeSelection = false;

                NavigationManager.NavigateTo("/");
            }
            catch (Exception ex)
            {
                ErrorMessage = ex.Message;
            }
            finally
            {
                IsImporting = false;
                StateHasChanged();
            }

            return;
        }

        // Zeitraum auswählen lassen
        MinHistory = range.Min;
        MaxHistory = range.Max;

        SelectedFrom = range.Max.AddDays(-(TimelineConstants.MaxImportDays - 1));
        SelectedTo = range.Max;

        ShowRangeSelection = true;
    }


    

    private async Task ImportSelectedRange()
    {
        ErrorMessage = null;

        if (SelectedFrom > SelectedTo)
        {
            ErrorMessage = "Der Startzeitpunkt darf nicht nach dem Endzeitpunkt liegen.";
            return;
        }

        if ((SelectedTo - SelectedFrom).TotalDays >= TimelineConstants.MaxImportDays)
        {
            ErrorMessage =
                $"Der Analysezeitraum darf maximal {TimelineConstants.MaxImportDays} Tage umfassen.";

            return;
        }

        IsImporting = true;
        StateHasChanged();

        try
        {
            await Loader.LoadProfileAsync(
                CurrentProfilePath!,
                new ImportRange
                {
                    From = SelectedFrom,
                    To = SelectedTo
                });

            await PersistService.PersistStateAsync(State);

            ShowRangeSelection = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsImporting = false;
            StateHasChanged();
        }
    }

    private string SelectedProfile
    {
        get => _selectedProfile;

        set
        {
            _selectedProfile = value;
            ApplyProfile();
        }
    }

    private void ApplyProfile()
    {
        switch (SelectedProfile)
        {
            case "7":

                TimelineConstants.MaxImportDays = 7;
                TimelineConstants.HeavyClusterThreshold = 20;
                break;

            case "14":

                TimelineConstants.MaxImportDays = 14;
                TimelineConstants.HeavyClusterThreshold = 30;
                break;

            case "30":

                TimelineConstants.MaxImportDays = 30;
                TimelineConstants.HeavyClusterThreshold = 40;
                break;

            case "custom":
                // Werte bleiben erhalten.
                break;
        }
    }


    private async Task<string?> SelectProfileFolderFromFile()
    {
        var file = await FilePicker.Default.PickAsync();

        if (file != null)
        {
            return Path.GetDirectoryName(file.FullPath);
        }

        return null;
    }


    // Neuer Button zum Löschen aller Daten
    private async Task ClearAllData()
    {
        State.ClearAll();
        await PersistService.PersistStateAsync(State);
    }
}

<div class="import-page">

    @if (IsImporting)
    {
        <div class="import-overlay">

            <div class="import-loading-card">

                <div class="spinner"></div>

                <h3>Browserprofil wird importiert...</h3>

                <p>
                    Bitte warten. Je nach Größe des Browserprofils kann
                    der Import einige Zeit dauern.
                </p>

            </div>

        </div>
    }

    <div class="import-panel">

        <div class="import-header">
            DATENIMPORT
        </div>

        <div class="import-content">

            <!-- ========================================= -->
            <!-- PROFILIMPORT -->
            <!-- ========================================= -->

            <div class="import-section">

                <div class="import-title">
                    Chromium-Profil
                </div>

                <div class="import-description">
                    Importiert Browser-Verlauf, Cookies, Autofill-Daten,
                    Browser-Erweiterungen sowie weitere unterstützte
                    Browserartefakte aus einem Chromium-Profil.
                </div>

                <div class="import-info">

                    <strong>Hinweis</strong>

                    <div>
                        Die empfohlenen Analyseprofile wurden für den typischen Einsatz
                        des Prototyps abgestimmt und liefern in den meisten Fällen die
                        besten Ergebnisse. Änderungen an den Parametern sollten nur
                        vorgenommen werden, wenn dies für spezielle Analysefälle
                        erforderlich ist.
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="import-error">
                        @ErrorMessage
                    </div>
                }

                <button class="import-btn primary"
                        @onclick="ImportChromeProfile">
                    Chromium-Profil importieren
                </button>

                <select class="import-input"
                        @bind="SelectedProfile">

                    <option value="7">7 Tage (Empfohlen)</option>
                    <option value="14">14 Tage (Empfohlen)</option>
                    <option value="30">30 Tage</option>
                    <option value="custom">Benutzerdefiniert</option>

                </select>

                @if (SelectedProfile == "custom")
                {
                    <div class="import-item">

                        <span>Maximale Importdauer (Tage)</span>

                        <input type="number"
                               class="import-input"
                               min="1"
                               max="365"
                               @bind="TimelineConstants.MaxImportDays" />

                    </div>
                }

                <div class="import-item">

                    <span>Clusterbildung ab Besuchen</span>

                    <input type="number"
                           class="import-input"
                           min="2"
                           @bind="TimelineConstants.HeavyClusterThreshold" />

                </div>

            </div>


            <!-- ========================================= -->
            <!-- ZEITRAUMAUSWAHL -->
            <!-- ========================================= -->
            @if (ShowRangeSelection)
            {
                <div class="import-section">

                    <div class="import-title">
                        Analysezeitraum auswählen
                    </div>

                    <div class="import-description">
                        Das ausgewählte Browserprofil enthält einen längeren
                        Browser-Verlauf. Bitte wählen Sie einen Analysezeitraum
                        von maximal <strong>@TimelineConstants.MaxImportDays Tagen</strong> aus.
                    </div>

                    <div class="profile-box">

                        <div>
                            <strong>Verfügbarer Browser-Verlauf</strong>
                        </div>

                        <div>
                            @MinHistory.ToString("dd.MM.yyyy")
                            –
                            @MaxHistory.ToString("dd.MM.yyyy")
                        </div>

                        <br />

                        <div>
                            <strong>Ausgewählter Zeitraum</strong>
                        </div>

                        <div>
                            @SelectedFrom.ToString("dd.MM.yyyy")
                            –
                            @SelectedTo.ToString("dd.MM.yyyy")
                        </div>

                    </div>

                    <!-- Hier kommt später der Timeline-Slider hin -->

                    <button class="import-btn primary"
                            @onclick="ImportSelectedRange">
                        Zeitraum importieren
                    </button>

                </div>
            }

            <!-- ========================================= -->
            <!-- AKTUELLES PROFIL -->
            <!-- ========================================= -->

            <div class="import-section">

                <div class="import-title">
                    Aktuelles Profil
                </div>

                <div class="profile-box">
                    @(string.IsNullOrWhiteSpace(CurrentProfilePath)
                        ? "Kein Profil ausgewählt."
                        : CurrentProfilePath)
                </div>

            </div>

            <!-- ========================================= -->
            <!-- GEFAHRENBEREICH -->
            <!-- ========================================= -->

            <div class="import-section danger-zone">

                <div class="import-title">
                    Gefahrenbereich
                </div>

                <div class="import-description">
                    Entfernt alle aktuell importierten Browserartefakte,
                    Analyseergebnisse und den aktuellen Fall aus dem Arbeitsspeicher.
                </div>

                <button class="import-btn danger"
                        @onclick="ClearAllData">
                    Alle Daten löschen
                </button>

            </div>

        </div>

    </div>

</div>
