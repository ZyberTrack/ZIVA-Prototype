    {
        ResetSelection();

        selectedExtension = ext;

        SyncFocusedArtifact(ext);

        await CenterOnTime(ext.InstallTime);
    }

    async Task SelectCookie(BrowserCookieEntry cookie)
    {
        ResetSelection();

        selectedCookie = cookie;

        SyncFocusedArtifact(cookie);

        await CenterOnTime(cookie.Created);
    }

    void CloseAll()
    {
        selectedExtension = null;
        selectedCookie = null;
        selectedInput = null;
        selectedDomain = null;
        selectedSubEntry = null;
        selectedStorage = null;
        selectedAnomaly = null;
    }

    async Task SelectSubEntry(
    DomainEntry domainEntry,
    BrowserHistoryEntry sub)
    {
        ResetSelection();

        selectedDomain = domainEntry;
        selectedSubEntry = sub;

        SyncFocusedArtifact(sub);
        SyncFocusedArtifact(domainEntry);

        await CenterOnTime(sub.VisitTime);
    }

    void ResetSelection()
    {
        selectedExtension = null;
        selectedCookie = null;
        selectedInput = null;
        selectedDomain = null;
        selectedSubEntry = null;
        selectedStorage = null;
    }

    private string GetTopFindings(BrowserExtensionEntry ext)
    {
        return string.Join(" | ",
            ext.Findings
               .OrderByDescending(f => f.Weight)
               .Take(2)
               .Select(f => f.Description));
    }

    //------------------------------------------------------------
    // Initial Render
    //------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        await UpdateViewportSizeAsync();

        await LoadAnomalyListsAsync();

        State.OnChange += Refresh;

        // Nur State laden – KEIN direktes DB-Laden mehr!
        await PersistService.LoadPersistedStateAsync(State);

    }

    private void Refresh()
    {
        SummarizedEntries = SummarizeEntries(
        State.BrowserEntries,
        zoomLevels[currentZoomIndex].seconds
        );

        foreach (var entry in SummarizedEntries)
        {
            // Farbe nur einmal berechnen
            entry.RenderColor = ColorService.GetColor(entry.Url);

            // Expand-State übernehmen oder initial setzen
            if (expandedStates.TryGetValue(entry.Domain, out bool expanded))
            {
                entry.IsExpanded = expanded;
            }
            else
            {
                entry.IsExpanded = allExpanded;
                expandedStates[entry.Domain] = allExpanded;
            }
        }

        var aggregator = new UserInputAggregatorService();

        UserInputs = aggregator.Build(
            State.BrowserEntries,
            State.AutofillEntries,
            State.Favicons
        );

        RecalculatePositions(
        State.BrowserEntries,
        x => x.VisitTime,
        (x, pos) => x.Position = pos
    );

        RecalculatePositions(
            State.BrowserCookies,
            x => x.Created,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            UserInputs,
            x => x.Time,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            SummarizedEntries,
            x => x.VisitTime,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            State.Extensions,
            x => x.InstallTime,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            State.StorageEntries,
            x => x.Time,
            (x, pos) => x.Position = pos
        );

        RelationService.BuildRelations(
            SummarizedEntries,
            State.BrowserCookies,
            UserInputs,
            State.Extensions,
            State.StorageEntries
        );

        Anomalies = AnomalyService.Detect(
            SummarizedEntries,
            State.BrowserCookies,
            State.AutofillEntries,
            UserInputs,
            State.Extensions,
            BlacklistDomains,
            SuspiciousDomains
        );

        RecalculateAnomalyPositions();

        BuildArtifactTimeline();
        UpdateVisibleTimestamps();

        InvokeAsync(StateHasChanged);

        RenderCache.BuildVisibleCaches(
            State.BrowserCookies,
            UserInputs,
            State.Extensions,
            State.StorageEntries,
            SummarizedEntries,
            Anomalies,
            viewportWidth
        );
    }

    private void BuildArtifactTimeline()
    {
        TimelineArtifacts.Clear();

        TimelineArtifacts.AddRange(
            State.BrowserEntries.Select(e => new TimelineArtifact
            {
                Time = e.VisitTime,
                Data = e,
                Type = ArtifactType.History
            })
        );

        TimelineArtifacts.AddRange(
            State.BrowserCookies.Select(c => new TimelineArtifact
            {
                Time = c.Created,
                Data = c,
                Type = ArtifactType.Cookie
            })
        );

        TimelineArtifacts.AddRange(
            UserInputs.Select(i => new TimelineArtifact
            {
                Time = i.Time,
                Data = i,
                Type = ArtifactType.UserInput
            })
        );

        TimelineArtifacts.AddRange(
            State.Extensions.Select(e => new TimelineArtifact
            {
                Time = e.InstallTime,
                Data = e,
                Type = ArtifactType.Extension
            })
        );

        TimelineArtifacts.AddRange(
            State.StorageEntries.Select(s => new TimelineArtifact
            {
                Time = s.Time,
                Data = s,
                Type = ArtifactType.Storage
            })
        );

        TimelineArtifacts.AddRange(
            Anomalies.Select(a => new TimelineArtifact
            {
                Time = a.FirstSeen,
                Data = a,
                Type = ArtifactType.Anomaly
            })
        );

        TimelineArtifacts = TimelineArtifacts
            .OrderBy(t => t.Time)
            .ToList();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerResizeHandler", selfRef);
            await JS.InvokeVoidAsync("timelineInterop.registerScrollHandler", selfRef, scrollDivRef);
            await JS.InvokeVoidAsync("registerDragHandler", selfRef);
            await JS.InvokeVoidAsync("registerZoomHandler", selfRef);
            await JS.InvokeVoidAsync("registerArrowKeys", selfRef);
        }
    }


