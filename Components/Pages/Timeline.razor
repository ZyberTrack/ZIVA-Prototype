    string GetAnomalyKey(AnomalyType type, string domain)
    => $"{type}:{domain.ToLower()}";

    // Anomalien detecten!
    void DetectAnomalies()
    {
        if (!SummarizedEntries.Any()) return;

        Anomalies.Clear();
        var anomalyIndex = new Dictionary<string, AnomalyEntry>();

        // 🔴 bestehende Domain-Anomalien
        //DetectDomainAnomalies(anomalyIndex);

        // 🧨 NEU: Gelöschter Verlauf – Cookies
        DetectOrphanCookies(anomalyIndex);

        // 🧨 NEU: Gelöschter Verlauf – Autofill
        DetectOrphanAutofill(anomalyIndex);

        foreach (var domain in SummarizedEntries)
        {
            // ✅ ZEITEN statt PIXEL
            var artifactTimes = domain.SubEntries.Any()
                ? domain.SubEntries.Select(s => s.VisitTime)
                : new[] { domain.VisitTime };

            // 🔴 Blacklist
            if (BlacklistDomains.Any(b =>
                domain.Domain.Contains(b, StringComparison.OrdinalIgnoreCase)))
            {
                AddOrUpdateAnomaly(
                    anomalyIndex,
                    AnomalyType.BlacklistedDomain,
                    domain,
                    artifactTimes,   // ✅ RICHTIG
                    severity: 5,
                    description: "Domain befindet sich auf der Blacklist"
                );

                continue;
            }

            // 🟠 Suspicious
            if (SuspiciousDomains.Any(s =>
                domain.Domain.Contains(s, StringComparison.OrdinalIgnoreCase)))
            {
                AddOrUpdateAnomaly(
                    anomalyIndex,
                    AnomalyType.SuspiciousRedirect,
                    domain,
                    artifactTimes,   // ✅ RICHTIG
                    severity: 3,
                    description: "Verdächtige interne oder lokale Domain"
                );
            }
        }

        Anomalies.AddRange(anomalyIndex.Values);
    }

    string GetAnomalyKey(
    AnomalyType type,
    DomainEntry domain,
    DateTime time,
    string? artifactId = null)
    {
        return type switch
        {
            AnomalyType.DeletedHistoryIndicator =>
                $"{type}:{domain.Domain.ToLower()}:{time:yyyyMMddHHmmss}:{artifactId}",

            _ =>
                $"{type}:{domain.Domain.ToLower()}"
        };
    }


    void AddOrUpdateAnomaly(
    Dictionary<string, AnomalyEntry> index,
    AnomalyType type,
    DomainEntry domain,
    IEnumerable<DateTime> artifactTimes,
    int severity,
    string description,
    string? artifactId = null)
    {
        var first = artifactTimes.Min();
        var last = artifactTimes.Max();

        var key = GetAnomalyKey(type, domain, first, artifactId);

        if (index.TryGetValue(key, out var existing))
        {
            existing.Count++;
            existing.FirstSeen = existing.FirstSeen < first ? existing.FirstSeen : first;
            existing.LastSeen = existing.LastSeen > last ? existing.LastSeen : last;
            existing.Severity = Math.Max(existing.Severity, severity);
            return;
        }

        index[key] = new AnomalyEntry
        {
            FirstSeen = first,
            LastSeen = last,
            LinkedDomain = domain,
            Type = type,
            Severity = severity,
            Description = description,
            Count = 1
        };
    }


    string NormalizeDomain(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return "";

        input = input.Trim().ToLower();

        if (input.StartsWith("."))
            input = input[1..];

        // URLs erlauben
        if (Uri.TryCreate(input, UriKind.Absolute, out var uri))
            return uri.Host;

        return input;
    }

    void DetectOrphanCookies(Dictionary<string, AnomalyEntry> anomalyIndex, int toleranceSeconds = 60)
    {
        if (State.BrowserCookies == null) return;

        foreach (var cookie in State.BrowserCookies)
        {
            string cookieDomain = NormalizeDomain(cookie.Host);

            bool hasMatchingHistory = SummarizedEntries.Any(domain =>
            {
                string domainNorm = NormalizeDomain(domain.Domain);

                if (!domainNorm.EndsWith(cookieDomain) &&
                    !cookieDomain.EndsWith(domainNorm))
                    return false;

                return Math.Abs((domain.VisitTime - cookie.Created).TotalSeconds)
                       <= toleranceSeconds;
            });

            if (!hasMatchingHistory)
            {
                var linkedDomain = FindClosestDomain(cookie.Created);

                AddOrUpdateAnomaly(
                    anomalyIndex,
                    AnomalyType.DeletedHistoryIndicator,
                    linkedDomain ?? new DomainEntry { Domain = cookieDomain },
                    new[] { cookie.Created },
                    severity: 4,
                    description: $"Cookie für Domain '{cookieDomain}' ohne passenden Verlaufseintrag"
                );
            }
        }
    }


    DomainEntry? FindClosestDomain(DateTime time)
    {
        return SummarizedEntries
            .OrderBy(d => Math.Abs((d.VisitTime - time).TotalSeconds))
            .FirstOrDefault();
    }

    void DetectOrphanAutofill(Dictionary<string, AnomalyEntry> anomalyIndex, int toleranceSeconds = 120)
    {
        if (State.AutofillEntries == null) return;

        foreach (var autofill in State.AutofillEntries)
        {
            bool hasMatchingDomain = SummarizedEntries.Any(domain =>
                Math.Abs((domain.VisitTime - autofill.DateCreated).TotalSeconds)
                <= toleranceSeconds
            );

            if (!hasMatchingDomain)
            {
                var linkedDomain = FindClosestDomain(autofill.DateCreated);

                AddOrUpdateAnomaly(
                    anomalyIndex,
                    AnomalyType.DeletedHistoryIndicator,
                    linkedDomain ?? new DomainEntry { Domain = "[unknown]" },
                    new[] { autofill.DateCreated },
                    severity: 5,
                    description: $"Autofill '{autofill.Name}' ohne zugehörigen Seitenaufruf"
                );
            }
        }
    }





    //------------------------------------------------------------
    // Domänen Zusammenfassungen
    //------------------------------------------------------------

    private List<DomainEntry> SummarizeEntries(List<BrowserHistoryEntry> entries, int maxSecondsBetween = 10)
    {
        var summarized = new List<DomainEntry>();
        DomainEntry? current = null;

        // 1) VORVERARBEITUNG: Domain-Hit-Count
        var domainCounts = entries
            .GroupBy(e => new Uri(e.Url).Host.ToLower())
            .ToDictionary(g => g.Key, g => g.Count());

        // 2) Heavy-Cluster: alle Domains mit >10 Visits
        var heavyDomains = domainCounts
            .Where(kvp => kvp.Value > 10)
            .Select(kvp => kvp.Key)
            .ToList();

        // Mapping: domain -> cluster index
        Dictionary<string, int> heavyClusterIndices = new();
        int clusterCounter = 1; // 1 = erste Linie über dem normalen Strahl

        foreach (var d in heavyDomains)
            heavyClusterIndices[d] = clusterCounter++;

        // ---- ORIGINAL Logik bleibt bestehen ----
        foreach (var entry in entries.OrderBy(e => e.VisitTime))
        {
            string domain = new Uri(entry.Url).Host.ToLower();

            bool isHeavy = heavyClusterIndices.ContainsKey(domain);

            if (isHeavy)
            {
                // Ein Heavy-Cluster erzeugt KEINE normalen „Domain-Wechsel“-Gruppen.
                // Sondern alles wird EINEM gemeinsamen Cluster zugeordnet.

                // Prüfen, ob URL eine bekannte Suchmaschine ist
                bool isSearch = searchEngines.Any(se => entry.Url.Contains(se)) &&
                                (entry.Url.Contains("/search") || entry.Url.Contains("q=") || entry.Url.Contains("?q="));

                summarized.Add(new DomainEntry
                {
                    Domain = domain,
                    Url = entry.Url,
                    VisitTime = entry.VisitTime,
                    IsDirect = entry.ReferrerUrl == null,
                    IsSearch = isSearch,

                    IsHeavyCluster = true,
                    HeavyClusterIndex = heavyClusterIndices[domain],
                });

                // Füge jeden Eintrag als SubEntry hinzu
                var cluster = summarized.First(e => e.Domain == domain && e.IsHeavyCluster);
                cluster.SubEntries.Add(entry);

                continue;
            }

            // ---- Normale Zusammenfassung ----
            if (current == null ||
                current.Domain != domain ||
                (entry.VisitTime - current.VisitTime).TotalSeconds > maxSecondsBetween)
            {

                // Prüfen, ob URL eine bekannte Suchmaschine ist
                bool isSearch = searchEngines.Any(se => entry.Url.Contains(se)) &&
                                (entry.Url.Contains("/search") || entry.Url.Contains("q=") || entry.Url.Contains("?q="));

                current = new DomainEntry
                {
                    Domain = domain,
                    Url = entry.Url,
                    VisitTime = entry.VisitTime,
                    IsDirect = entry.ReferrerUrl == null,
                    IsSearch = isSearch,
                };

                // **Ersten Eintrag direkt als SubEntry hinzufügen**
                current.SubEntries.Add(entry);

                summarized.Add(current);
            }
            else
            {
                current.SubEntries.Add(entry);
                if (entry.ReferrerUrl != null)
                    current.IsDirect = false;
            }
        }

        return summarized;
    }

    //------------------------------------------------------------
    // Bessere Domain-Farbzuweisung mit maximaler Farbdistanz (HSL)
    //------------------------------------------------------------

    // Gibt HEX-Farbe aus HSL zurück
    private string HslToRgb(int h, int s, int l)
    {
        double sat = s / 100.0;
        double light = l / 100.0;
        double c = (1 - Math.Abs(2 * light - 1)) * sat;
        double x = c * (1 - Math.Abs((h / 60.0) % 2 - 1));
        double m = light - c / 2;

        double r = 0, g = 0, b = 0;

        if (h < 60) { r = c; g = x; b = 0; }
        else if (h < 120) { r = x; g = c; b = 0; }
        else if (h < 180) { r = 0; g = c; b = x; }
        else if (h < 240) { r = 0; g = x; b = c; }
        else if (h < 300) { r = x; g = 0; b = c; }
        else { r = c; g = 0; b = x; }

        int R = (int)((r + m) * 255);
        int G = (int)((g + m) * 255);
        int B = (int)((b + m) * 255);

        return $"rgb({R},{G},{B})";
    }

    // Gibt gut unterscheidbare Farbe für eine Domain zurück
    private string GetColorForDomain(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "rgb(200,200,200)";

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return "rgb(200,200,200)";

        string domain = uri.Host.ToLower();

        // Falls schon eine Farbe existiert → zurückgeben
        if (domainColors.ContainsKey(domain))
            return domainColors[domain];

        // Neuen Hue-Wert wählen
        int hue = (usedHues.Count * HueStep) % 360;
        usedHues.Add(hue);

        // Farbe generieren
        string color = HslToRgb(hue, Saturation, Lightness);

        domainColors[domain] = color;
        return color;
    }

    //------------------------------------------------------------
	// JavaScript Interop: Scrollen, Zoomen, Resizing
    //------------------------------------------------------------

    [JSInvokable("OnResize")] // Elemente werden Visuell dem Fenster angepasst
    public async Task OnResizeAsync()
    {
        isResizing = true;

        await UpdateViewportSizeAsync();

        Refresh();

        isResizing = false;
        StateHasChanged();
    }

    // Scroll Funktion
    [JSInvokable("OnAsyncScroll")]
    public async Task OnAsyncScroll(double scrollLeft)
    {
        if (isProgrammaticScroll || isZooming)
        {
            isProgrammaticScroll = false;
            return;
        }

        scrollIndex = scrollLeft;

        if (scrollIndex < 50000 || scrollIndex > movableLayerWidth - 50000)
        {
            double newOffset = movableLayerWidth / 2;
            int indexShift = (int)((scrollIndex - newOffset) / spacing);

            // Aktuelles ZoomLevel abrufen
            var currentZoom = zoomLevels[currentZoomIndex];
            var spacingTimeSpan = GetTimeSpanFromZoomLevel(currentZoom);

            // Zeitbasis verschieben
            baseTime = baseTime.AddTicks(spacingTimeSpan.Ticks * indexShift);

            // Scrollposition korrigieren
            scrollIndex = scrollIndex - indexShift * spacing;

            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50); // Browser braucht kurz Zeit
            isProgrammaticScroll = false;

            UpdateVisibleTimestamps();
            RecalculatePositions();
            StateHasChanged();
            return;
        }

        Refresh();
        StateHasChanged();
    }

    [JSInvokable("OnZoom")]
    public async Task OnZoomAsync(string direction)
    {
        isZooming = true;

        // 1️⃣ Scrollgrenzen für aktuellen Zustand absichern
        scrollIndex = Math.Clamp(
            scrollIndex,
            0,
            Math.Max(0, movableLayerWidth - viewportWidth)
        );

        // 2️⃣ Mittelpunkt-Zeit aus aktuellem Zustand ermitteln
        double centerPx = scrollIndex + viewportWidth / 2;
        DateTime centerTime = PixelToTime(centerPx);

        // 3️⃣ Zoomstufe ändern
        if (direction == "in" && currentZoomIndex > 0)
            currentZoomIndex--;
        else if (direction == "out" && currentZoomIndex < zoomLevels.Length - 1)
            currentZoomIndex++;

        // 4️⃣ Neue Scrollposition für dieselbe Zeit berechnen
        double newCenterPx = TimeToPixel(centerTime);
        double newScrollLeft = newCenterPx - viewportWidth / 2;

        // 5️⃣ 🔥 WICHTIG: neuen Scrollwert übernehmen
        scrollIndex = Math.Clamp(
            newScrollLeft,
            0,
            Math.Max(0, movableLayerWidth - viewportWidth)
        );

        // 6️⃣ Optional: Scroll-Container synchronisieren
        isProgrammaticScroll = true;
        await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
        await Task.Delay(1);
        isProgrammaticScroll = false;

        // 7️⃣ ALLE Pixel neu berechnen (JETZT korrekt!)
        Refresh();

        StateHasChanged();
        isZooming = false;
    }


    [JSInvokable("OnArrowRight")]
    public async Task OnArrowRightAsync()
    {
        if (currentPivotIndex < State.BrowserEntries.Count - 1)
            await CenterOnEntry(currentPivotIndex + 1);
        Refresh();
        StateHasChanged();
    }

    [JSInvokable("OnArrowLeft")]
    public async Task OnArrowLeftAsync()
    {
        if (currentPivotIndex > 0)
            await CenterOnEntry(currentPivotIndex - 1);
        Refresh();
        StateHasChanged();
    }

    async Task ExpandAndFocus(DomainEntry domainEntry)
    {
        ResetSelection();

        selectedDomain = domainEntry;

        domainEntry.IsExpanded = true;

        int index = State.BrowserEntries.FindIndex(e =>
            Math.Abs((e.VisitTime - domainEntry.VisitTime).TotalSeconds) < 1);

        if (index >= 0)
        {
            currentPivotIndex = index;
            await CenterOnEntry(index);
        }

        Refresh();

        StateHasChanged();
    }



    //------------------------------------------------------------
	// Verschiedene Hilfsmethoden
    //------------------------------------------------------------

    // zentriert Timeline um ein entry.
    private async Task CenterOnEntry(int index)
    {
        if (State.BrowserEntries == null || !State.BrowserEntries.Any())
            return;

        // Index clampen
        index = Math.Clamp(index, 0, State.BrowserEntries.Count - 1);
        currentPivotIndex = index;

        var entry = State.BrowserEntries[currentPivotIndex];

        // baseTime auf den Pivot-Entry setzen
        baseTime = entry.VisitTime;

        // scrollIndex so berechnen, dass Pivot in die Mitte des Viewports kommt
        scrollIndex = TimeToPixel(entry.VisitTime) - viewportWidth / 2;

        // Scrollgrenzen sichern
        scrollIndex = Math.Clamp(scrollIndex, 0, Math.Max(0, movableLayerWidth - viewportWidth));

        // Anzeige aktualisieren
        Refresh();
        StateHasChanged();

        // Optional: Browser scrollen, falls du einen externen Scroll-Container hast
        await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
    }

    private double GetPixelPerUnit()
    {
        // spacing bleibt fix
        double fixedSpacing = spacing;

        // aktuelle Zoomstufe
        double valueInSeconds = zoomLevels[currentZoomIndex].seconds;
        TimeUnit unit = zoomLevels[currentZoomIndex].unit;

        // Dynamisch die Einheit anpassen
        while (true)
        {
            // Berechne value in der aktuellen Einheit
            double valueInCurrentUnit = valueInSeconds;
            switch (unit)
            {
                case TimeUnit.Seconds:
                    break; // bleibt Sekunden
                case TimeUnit.Minutes:
                    valueInCurrentUnit /= 60.0;
                    break;
                case TimeUnit.Hours:
                    valueInCurrentUnit /= 3600.0;
                    break;
                case TimeUnit.Days:
                    valueInCurrentUnit /= 86400.0;
                    break;
                case TimeUnit.Months:
                    valueInCurrentUnit /= (30 * 86400.0);
                    break;
                case TimeUnit.Years:
                    valueInCurrentUnit /= (365 * 86400.0);
                    break;
            }

            // Prüfen: passt valueInCurrentUnit zu spacing?
            if (valueInCurrentUnit <= fixedSpacing || unit == TimeUnit.Years)
                break;

            // sonst nächstgrößere Einheit wählen
            unit = unit switch
            {
                TimeUnit.Seconds => TimeUnit.Minutes,
                TimeUnit.Minutes => TimeUnit.Hours,
                TimeUnit.Hours => TimeUnit.Days,
                TimeUnit.Days => TimeUnit.Months,
                TimeUnit.Months => TimeUnit.Years,
                TimeUnit.Years => TimeUnit.Years
            };
        }

        // Pixel pro Einheit = spacing / valueInCurrentUnit
        double pixelPerUnit = fixedSpacing / valueInSeconds;

        return pixelPerUnit;
    }

    private double TimeToPixel(DateTime t)
    {
        double secondsFromBase = (t - baseTime).TotalSeconds;
        double pixelsPerSecond = GetPixelPerUnit();

        return InitialOffsetPx + secondsFromBase * pixelsPerSecond;
    }

	// Darstellung der History Einträge in der Zeitachse
    private DateTime PixelToTime(double px)
    {
        double pixelsFromStart = px - InitialOffsetPx;
        double secondsPerPixel = zoomLevels[currentZoomIndex].seconds / spacing;

        double secondsFromBase = pixelsFromStart * secondsPerPixel;

        return baseTime.AddSeconds(secondsFromBase);
    }

    // Für scroll Funktion wird die Zeitspanne aus der Zoomstufe berechnet
    private TimeSpan GetTimeSpanFromZoomLevel((int seconds, TimeUnit unit) zoomLevel)
    {
        return zoomLevel.unit switch
        {
            TimeUnit.Seconds => TimeSpan.FromSeconds(zoomLevel.seconds),
            TimeUnit.Minutes => TimeSpan.FromMinutes(zoomLevel.seconds / 60.0),
            TimeUnit.Hours => TimeSpan.FromHours(zoomLevel.seconds / 3600.0),
            TimeUnit.Days => TimeSpan.FromDays(zoomLevel.seconds / 86400.0),
            TimeUnit.Months => TimeSpan.FromDays(zoomLevel.seconds / 86400.0), // Näherung: 1 Monat = 30 Tage
            TimeUnit.Years => TimeSpan.FromDays(zoomLevel.seconds / 86400.0),  // Näherung: 1 Jahr = 365 Tage
            _ => TimeSpan.FromSeconds(zoomLevel.seconds)
        };
    }

    // Berechnet die Distanz zwischen zwei Zeitpunkten in der aktuellen Zeiteinheit
    private double GetUnitDistance(DateTime from, DateTime to)
    {
        return CurrentTimeUnit switch
        {
            TimeUnit.Seconds => (to - from).TotalSeconds,
            TimeUnit.Minutes => (to - from).TotalMinutes,
            TimeUnit.Hours => (to - from).TotalHours,
            TimeUnit.Days => (to - from).TotalDays,
            TimeUnit.Months => ((to.Year - from.Year) * 12 + to.Month - from.Month)
                                + (to.Day - from.Day) / 30.0,
            TimeUnit.Years => (to.Year - from.Year)
                                + (to.DayOfYear - from.DayOfYear) / 365.0,
            _ => 0
        };
    } 

    public void Dispose()
    {
        selfRef?.Dispose();
    }
}

