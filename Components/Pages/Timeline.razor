@page "/"
@inject IJSRuntime JS
@implements IDisposable
@using ZIVA_Prototype.Components.Models
@using ZIVA_Prototype.Services;
@inject TimelineStateService State // Verwaltet States mehrerer Importierter Datenbanken
@inject HistoryImportService Importer

@code {


    //
    // TIMELINE ARTEFAKTE WERDEN NICHT ANGEZEIGT. 
    // 
    // TO DO:
	// 
	// 
	// -- Workaround fürs Zoom -> Pivoting between entrys.
    // 
    //

    private bool isZooming = false; // Flag to indicate if zooming is in progress
    private BrowserHistoryEntry? selectedEntry; // Aktuell ausgewählte Browser History Artefakt Entry
    private BrowserCookieEntry? selectedCookie; // Aktuell ausgewählte Browser Cookies Artefakt Entry
    private bool isProgrammaticScroll = false; //scroll lock, damit nicht bei jedem Scrollen die Position neu berechnet wird

    private ElementReference scrollDivRef;
    private const int InitialOffsetPx = 2500000; // z. B. Mitte der 500000px Fläche Für zeitachse
    private double scrollIndex = 0;
    private int viewportWidth;
    private int startOffset = 70;
    private int spacing = 250;
    private int movableLayerWidth = 5000000;
    private int renderBuffer = 5;
    private int lastScrollIndex = int.MinValue;
    private DateTime baseTime = DateTime.Now; // Später durch Importdaten ersetzbar



    // Alles was ZOOMEN angeht, wird hier definiert.
    enum TimeUnit
    {
        Seconds,
        Minutes,
        Hours,
        Days,
        Months,
        Years
    }

    

    // neuer Ansatz: Zoomstufen definieren, die die Dauer eines Intervalls bestimmen
    private readonly (int seconds, TimeUnit unit)[] zoomLevels = new[]
    {
        (10, TimeUnit.Seconds),
        (60, TimeUnit.Minutes),
        (300, TimeUnit.Minutes),
        (600, TimeUnit.Minutes),
        (1200, TimeUnit.Minutes),
        (1800, TimeUnit.Minutes),
        (3600, TimeUnit.Hours),
        (7200, TimeUnit.Hours),
        (86400, TimeUnit.Hours),
        (172800, TimeUnit.Days),
        (259200, TimeUnit.Days),
        (604800, TimeUnit.Days),
        (1209600, TimeUnit.Days),
        (2419200, TimeUnit.Days),
        (5184000, TimeUnit.Days),
        (7776000, TimeUnit.Months),
        (10368000, TimeUnit.Months),
        (15552000, TimeUnit.Months),
        (31104000, TimeUnit.Years),
        (63072000, TimeUnit.Years),
    };

    private int currentZoomIndex = 5; // Start bei 10 Minuten (600 Sekunden)
    private int currentPivotIndex = 0; // Index in State.BrowserEntries
    private int SecondsPerSpacing => zoomLevels[currentZoomIndex].seconds;  //  Zoomstufe in Sekunden und bestimmt Dauer eines Intervalls



    // Neuer Ansatz: Zoomstufen in Units statt Sekunden
    private TimeUnit CurrentTimeUnit => zoomLevels[currentZoomIndex].unit;

    private DotNetObjectReference<Timeline>? selfRef;

    private List<TimestampEntry> visibleEntries = new();
    public class TimestampEntry
    {
        public int Index { get; set; }
        public DateTime Time { get; set; }
        public int Position { get; set; }
    }



    protected override async Task OnInitializedAsync()
    {
        await UpdateViewportWidthAsync();
        await LoadFromDatabase(); // Läd die History Datenbank Artefakte
        await LoadCookieDatabase(); // Läd die Cookie Datenbank Artefakte

        RecalculatePositions();
        RecalculateCookiePositions();
        UpdateVisibleTimestamps();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerResizeHandler", selfRef);
            await JS.InvokeVoidAsync("timelineInterop.registerScrollHandler", selfRef, scrollDivRef);
            await JS.InvokeVoidAsync("registerDragHandler", selfRef);
            await JS.InvokeVoidAsync("registerZoomHandler", selfRef);
            await JS.InvokeVoidAsync("registerArrowKeys", selfRef);
        }
    }

    private async Task LoadFromDatabase()
    {
        var filePath = Path.Combine(FileSystem.AppDataDirectory, "history.sqlite");

        // sicherstellen, dass die Datei existiert
        if (File.Exists(filePath))
        {
            var entries = Importer.LoadFromHistoryDatabase(filePath);
            State.SetBrowserEntries(entries);
        }
        else
        {
            Console.WriteLine("Datei nicht gefunden: " + filePath);
        }

        // Debugging
        //await JS.InvokeVoidAsync("alert", $"Importiert: {State.BrowserEntries.Count} Einträge");
        //await JS.InvokeVoidAsync("alert", $"Erste URL: {State.BrowserEntries.FirstOrDefault()?.Url}");


        // Initiale Breite der beweglichen Ebene setzen
        if (State.BrowserEntries is { Count: > 0 })
        {
            // Basiszeit auf den frühesten Zeitpunkt setzen
            baseTime = State.BrowserEntries.Min(e => e.VisitTime);

            // Viewport-Breite zuerst sicherstellen!
            await UpdateViewportWidthAsync();

            // Erstes Element ermitteln
            var first = State.BrowserEntries.First();

            // Zentriere den ersten Eintrag auf dem Bildschirm
            var unitDistance = GetUnitDistance(baseTime, first.VisitTime);
            var scrollTo = InitialOffsetPx + unitDistance * spacing;
            scrollIndex = scrollTo - viewportWidth / 2;

            // Jetzt scrollen
            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50); // Browser braucht kurz Zeit
            isProgrammaticScroll = false;

            visibleEntries.Clear();
            UpdateVisibleTimestamps();
            RecalculatePositions();
            StateHasChanged();
        }
    }


    private async Task LoadCookieDatabase()
    {
        var filePath = Path.Combine(FileSystem.AppDataDirectory, "cookies.sqlite");

        // sicherstellen, dass die Datei existiert
        if (File.Exists(filePath))
        {
            var cookieService = new CookieImportService();
            var cookies = cookieService.LoadFromCookieDatabase(filePath);
            State.SetBrowserCookies(cookies);
        }
        else
        {
            Console.WriteLine("Cookie-Datei nicht gefunden: " + filePath);
        }

        // Initiale Breite der Timeline setzen
        if (State.BrowserCookies is { Count: > 0 })
        {
            // Basiszeit: frühester "LastAccessed" (macht für Cookies am meisten Sinn)
            baseTime = State.BrowserCookies
                .Where(c => c.LastAccessed > DateTime.MinValue)
                .Min(c => c.LastAccessed);

            // Viewport-Breite aktualisieren
            await UpdateViewportWidthAsync();

            // Erstes Cookie — das neuste, entsprechend deiner ORDER BY last_access_utc DESC
            var first = State.BrowserCookies.First();

            // Zeitliche Distanz
            var unitDistance = GetUnitDistance(baseTime, first.LastAccessed);

            // Position berechnen
            var scrollTo = InitialOffsetPx + unitDistance * spacing;
            scrollIndex = scrollTo - viewportWidth / 2;

            // Scrollen
            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50);
            isProgrammaticScroll = false;

            visibleEntries.Clear();
            UpdateVisibleTimestamps();
            RecalculatePositions();
            StateHasChanged();
        }
    }





    // zentriert Timeline um ein entry.
    private async Task CenterOnEntry(int index)
    {
        if (State.BrowserEntries == null || !State.BrowserEntries.Any())
            return;

        // Index clampen
        index = Math.Clamp(index, 0, State.BrowserEntries.Count - 1);
        currentPivotIndex = index;

        var entry = State.BrowserEntries[currentPivotIndex];

        // baseTime auf den Pivot-Entry setzen
        baseTime = entry.VisitTime;

        // scrollIndex so berechnen, dass Pivot in die Mitte des Viewports kommt
        scrollIndex = TimeToPixel(entry.VisitTime) - viewportWidth / 2;

        // Scrollgrenzen sichern
        scrollIndex = Math.Clamp(scrollIndex, 0, Math.Max(0, movableLayerWidth - viewportWidth));

        // Anzeige aktualisieren
        UpdateVisibleTimestamps();
        RecalculatePositions();
        RecalculateCookiePositions();
        StateHasChanged();

        // Optional: Browser scrollen, falls du einen externen Scroll-Container hast
        await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
    }


    [JSInvokable("OnResize")] // Elemente werden Visuell dem Fenster angepasst
    public async Task OnResizeAsync()
    {
        await UpdateViewportWidthAsync();
        UpdateVisibleTimestamps();
        RecalculatePositions();
        RecalculateCookiePositions();
        StateHasChanged();
    }

    private async Task UpdateViewportWidthAsync()
    {
        viewportWidth = Math.Max(await JS.InvokeAsync<int>("getViewportWidth"), 300); // Minimum
    }

    // Nur Zeitstempel betreffend
    private void UpdateVisibleTimestamps()
    {
        int centerIndex = (int)((scrollIndex - InitialOffsetPx) / spacing);
        int firstVisibleIndex = (int)((scrollIndex - InitialOffsetPx) / spacing) - renderBuffer;
        int lastVisibleIndex = firstVisibleIndex + (int)(viewportWidth / spacing) + 2 * renderBuffer;


        visibleEntries = new();
        for (int i = firstVisibleIndex; i <= lastVisibleIndex; i++)
        {
            var entry = CreateEntry(i);
            entry.Position = InitialOffsetPx + i * spacing;            // direktes Positionieren, scrollBar sorgt für Bewegung
            visibleEntries.Add(entry);
        }

        //NEU: width so setzen, dass auch negative Einträge Platz haben
        int minIndex = firstVisibleIndex;
        int maxIndex = lastVisibleIndex;

        //Optional: baseOffset setzen, um negative Indexe sichtbar zu machen
        startOffset = -minIndex * spacing + 250; // z. B. 250px Puffer nach links
    }

    
    // Zeitstempel Einträge erstellen
    private TimestampEntry CreateEntry(int index)
    {
        var time = CurrentTimeUnit switch
        {
            TimeUnit.Seconds => baseTime.AddSeconds(index * SecondsPerSpacing),
            TimeUnit.Minutes => baseTime.AddMinutes(index * (SecondsPerSpacing / 60.0)),
            TimeUnit.Hours   => baseTime.AddHours(index * (SecondsPerSpacing / 3600.0)),
            TimeUnit.Days    => baseTime.AddDays(index * (SecondsPerSpacing / 86400.0)),
            TimeUnit.Months  => baseTime.AddMonths(index), // 1 Monat pro Intervall – Optional kannst du noch CurrentIntervalInMonths einführen
            TimeUnit.Years   => baseTime.AddYears(index),
            _ => baseTime
        };

        return new TimestampEntry
        {
            Index = index,
            Time = time,
            Position = 0
        };
    }

    // Nur für Einträge in der Zeitachse
    private void RecalculatePositions()
    {
        // Wird für jeden Eintrag gemacht
        foreach (var historyEntry in State.BrowserEntries)
        {
			historyEntry.Position = (int)TimeToPixel(historyEntry.VisitTime) - scrollIndex; //Hier geht was schief wenn die position mit dsem zoom nicht stimmt
        }
    }

    private void RecalculateCookiePositions()
    {
        if (State.BrowserCookies == null) return;

        foreach (var cookie in State.BrowserCookies)
        {
            cookie.Position = (int)TimeToPixel(cookie.LastAccessed) - (int)scrollIndex;
        }
    }


    private double GetPixelPerUnit()
    {
        // spacing bleibt fix
        double fixedSpacing = spacing;

        // aktuelle Zoomstufe
        double valueInSeconds = zoomLevels[currentZoomIndex].seconds;
        TimeUnit unit = zoomLevels[currentZoomIndex].unit;

        // Dynamisch die Einheit anpassen
        while (true)
        {
            // Berechne value in der aktuellen Einheit
            double valueInCurrentUnit = valueInSeconds;
            switch (unit)
            {
                case TimeUnit.Seconds:
                    break; // bleibt Sekunden
                case TimeUnit.Minutes:
                    valueInCurrentUnit /= 60.0;
                    break;
                case TimeUnit.Hours:
                    valueInCurrentUnit /= 3600.0;
                    break;
                case TimeUnit.Days:
                    valueInCurrentUnit /= 86400.0;
                    break;
                case TimeUnit.Months:
                    valueInCurrentUnit /= (30 * 86400.0);
                    break;
                case TimeUnit.Years:
                    valueInCurrentUnit /= (365 * 86400.0);
                    break;
            }

            // Prüfen: passt valueInCurrentUnit zu spacing?
            if (valueInCurrentUnit <= fixedSpacing || unit == TimeUnit.Years)
                break;

            // sonst nächstgrößere Einheit wählen
            unit = unit switch
            {
                TimeUnit.Seconds => TimeUnit.Minutes,
                TimeUnit.Minutes => TimeUnit.Hours,
                TimeUnit.Hours => TimeUnit.Days,
                TimeUnit.Days => TimeUnit.Months,
                TimeUnit.Months => TimeUnit.Years,
                TimeUnit.Years => TimeUnit.Years
            };
        }

        // Pixel pro Einheit = spacing / valueInCurrentUnit
        double pixelPerUnit = fixedSpacing / valueInSeconds;

        return pixelPerUnit;
    }


    //return spacing / zoomLevels[currentZoomIndex].seconds;  // Wert ist schon mal besser  -> Zoom ist nicht wirklich von spacing abhängig oder??

    private double TimeToPixel(DateTime t)
    {
        double secondsFromBase = (t - baseTime).TotalSeconds;
        double pixelsPerSecond = GetPixelPerUnit();

        return InitialOffsetPx + secondsFromBase * pixelsPerSecond;
    }

	// Darstellung der History Einträge in der Zeitachse
    private DateTime PixelToTime(double px)
    {
        double pixelsFromStart = px - InitialOffsetPx;
        double secondsPerPixel = zoomLevels[currentZoomIndex].seconds / spacing;

        double secondsFromBase = pixelsFromStart * secondsPerPixel;

        return baseTime.AddSeconds(secondsFromBase);
    }



    // Scroll Funktion
    [JSInvokable("OnAsyncScroll")]
    public async Task OnAsyncScroll(double scrollLeft)
    {
        if (isProgrammaticScroll || isZooming)
        {
            isProgrammaticScroll = false;
            return;
        }

        scrollIndex = scrollLeft;

        if (scrollIndex < 50000 || scrollIndex > movableLayerWidth - 50000)
        {
            double newOffset = movableLayerWidth / 2;
            int indexShift = (int)((scrollIndex - newOffset) / spacing);

            // Aktuelles ZoomLevel abrufen
            var currentZoom = zoomLevels[currentZoomIndex];
            var spacingTimeSpan = GetTimeSpanFromZoomLevel(currentZoom);

            // Zeitbasis verschieben
            baseTime = baseTime.AddTicks(spacingTimeSpan.Ticks * indexShift);

            // Scrollposition korrigieren
            scrollIndex = scrollIndex - indexShift * spacing;

            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50); // Browser braucht kurz Zeit
            isProgrammaticScroll = false;

            UpdateVisibleTimestamps();
            RecalculatePositions();
            StateHasChanged();
            return;
        }

        UpdateVisibleTimestamps();
        RecalculatePositions();
        RecalculateCookiePositions();
        StateHasChanged();
    }

    // Für scroll Funktion wird die Zeitspanne aus der Zoomstufe berechnet
    private TimeSpan GetTimeSpanFromZoomLevel((int seconds, TimeUnit unit) zoomLevel)
    {
        return zoomLevel.unit switch
        {
            TimeUnit.Seconds => TimeSpan.FromSeconds(zoomLevel.seconds),
            TimeUnit.Minutes => TimeSpan.FromMinutes(zoomLevel.seconds / 60.0),
            TimeUnit.Hours => TimeSpan.FromHours(zoomLevel.seconds / 3600.0),
            TimeUnit.Days => TimeSpan.FromDays(zoomLevel.seconds / 86400.0),
            TimeUnit.Months => TimeSpan.FromDays(zoomLevel.seconds / 86400.0), // Näherung: 1 Monat = 30 Tage
            TimeUnit.Years => TimeSpan.FromDays(zoomLevel.seconds / 86400.0),  // Näherung: 1 Jahr = 365 Tage
            _ => TimeSpan.FromSeconds(zoomLevel.seconds)
        };
    }

    // Berechnet die Distanz zwischen zwei Zeitpunkten in der aktuellen Zeiteinheit
    private double GetUnitDistance(DateTime from, DateTime to)
    {
        return CurrentTimeUnit switch
        {
            TimeUnit.Seconds => (to - from).TotalSeconds,
            TimeUnit.Minutes => (to - from).TotalMinutes,
            TimeUnit.Hours => (to - from).TotalHours,
            TimeUnit.Days => (to - from).TotalDays,
            TimeUnit.Months => ((to.Year - from.Year) * 12 + to.Month - from.Month)
                                + (to.Day - from.Day) / 30.0,
            TimeUnit.Years => (to.Year - from.Year)
                                + (to.DayOfYear - from.DayOfYear) / 365.0,
            _ => 0
        };
    }

    [JSInvokable("OnArrowRight")]
    public async Task OnArrowRightAsync()
    {
        if (currentPivotIndex < State.BrowserEntries.Count - 1)
            await CenterOnEntry(currentPivotIndex + 1);
    }

    [JSInvokable("OnArrowLeft")]
    public async Task OnArrowLeftAsync()
    {
        if (currentPivotIndex > 0)
            await CenterOnEntry(currentPivotIndex - 1);
    }


    [JSInvokable("OnZoom")]
    public async Task OnZoomAsync(string direction)
    {
        isZooming = true; //zoom sperre Flag setzen

        // Scrollgrenzen absichern
        scrollIndex = Math.Clamp(scrollIndex, 0, Math.Max(0, movableLayerWidth - viewportWidth));

        // Mittelpunkt-Zeit merken (zentriert im Viewport)
        double centerPx = scrollIndex + viewportWidth / 2;
        DateTime centerTime = PixelToTime(centerPx);  // ACHTUNG: ERROR anfälligkeit hier!!

        // Zoomstufe anpassen
        if (direction == "in" && currentZoomIndex > 0)
        {
            currentZoomIndex--;
            //pixelPerSecond *= 2; // Beispiel: 2x reinzoomen
        }
        else if (direction == "out" && currentZoomIndex < zoomLevels.Length - 1)
        {
            currentZoomIndex++;
            //pixelPerSecond /= 2; // Beispiel: 2x rauszoomen
        }

        // Neue Scrollposition berechnen, sodass die Zeit gleich bleibt
        double newCenterPx = TimeToPixel(centerTime);
        double newScrollLeft = newCenterPx - viewportWidth / 2;

        // Scrollgrenzen erneut absichern
        newScrollLeft = Math.Clamp(newScrollLeft, 0, Math.Max(0, movableLayerWidth - viewportWidth));

        // Darstellung aktualisieren
        UpdateVisibleTimestamps();
        RecalculatePositions();
        RecalculateCookiePositions();
        StateHasChanged();

        isZooming = false;
    }




    public void Dispose()
    {
        selfRef?.Dispose();
    }
}

<!-- RAZOR MARKUP -->
<div class="timeline-wrapper">
    <!-- LEFT SIDE OF TIMELINE -->
    <div class="legend-area">
        <div class="timeline-area-static timeline-area-top">
            <div class="timeline-label">Verlauf-Zeitachse</div> 
            <div class="timeline-history-label">Website Verlauf</div>
            <div class="timeline"></div>
            <div class="timeline-cookies-label">Cookies</div>
            <div class="timeline-cookies"></div>
            <div class="timeline-webdata-label">Web Data</div>
            <div class="timeline-webdata"></div>
            <div class="timeline-favicons-label">Favicons</div>
            <div class="timeline-favicons"></div>
        </div>
        <div class="timeline-area-static timeline-area-bottom">
            <div class="timeline-label">Analyse-Zeitachse</div>
            <div class="timeline"></div>
        </div>
    </div>

    <!-- MOVABLE TIMELINE -->
    <div class="timeline-static">
        <div class="timeline-area-scroll timeline-area-top">
            <div class="timeline"></div>
            <div class="timeline-cookies"></div>
            <div class="timeline-webdata"></div>
            <div class="timeline-favicons"></div>
        </div>

        <div class="timeline-area-scroll timeline-area-bottom">
            <div class="timeline"></div>
        </div>
    </div>

    <!-- RIGHT SIDE OF TIMELINE -->
    <div class="timeless-area">
        <div class="timeline-area-static">
            <div class="timeline-label">Zeitstempel Unbekannt</div>
            <div class="timeline"></div>
            <div class="timeline-cookies"></div>
            <div class="timeline-webdata"></div>
            <div class="timeline-favicons"></div>
        </div>
        <div class="timeline-area-static">
            <div class="timeline"></div>
        </div>
    </div>

    <div style="position: fixed; top: 600px; left: 80px; background: yellow; z-index: 1000; padding: 4px;">
        DEBUG: SecondsPerSpacing = @SecondsPerSpacing
        DEBUG: scrollIndex = @scrollIndex
        DEBUG: baseTime = @baseTime
		DEBUG: viewportWidth = @viewportWidth
        DEBUG: movableLayerWidth = @movableLayerWidth
        DEBUG: CurrentZoomIndex = @currentZoomIndex
        DEBUG: TimeStamp 0 @baseTime.AddHours(currentZoomIndex * (SecondsPerSpacing / 3600.0))


        <div style="display: flex; gap: 20px; margin-top: 10px;">
            <div style="flex: 1;">
                <strong>Visible History Entries (@State.BrowserEntries.Count):</strong>
                <ul style="font-size: 12px; padding-left: 20px;">
                    @foreach (var e in State.BrowserEntries)
                    {
                        <li>Time: @e.VisitTime, Pos: @e.Position</li>
                    }
                </ul>
            </div>

            <div style="flex: 1;">
                <strong>Visible Cookie Entries (@State.BrowserCookies.Count):</strong>
                <ul style="font-size: 12px; padding-left: 20px;">
                    @foreach (var e in State.BrowserCookies)
                    {
                        <li>Time: @e.LastAccessed, Pos: @e.Position</li>
                    }
                </ul>
            </div>

            <div style="flex: 1;">
                <strong>Visible Entries (@visibleEntries.Count):</strong>
                <ul style="font-size: 12px; padding-left: 20px;">
                    @foreach (var e in visibleEntries)
                    {
                        <li>Index: @e.Index, Time: @e.Time, Pos: @e.Position</li>
                    }
                </ul>
            </div>
        </div>
    </div>


    <div class="timeline-container">
        <!-- Externer Container mit fixer Breite & overflow -->
        <div id="scroll-container" class="scroll-wrapper scroll-wrapper-timeline" @ref="scrollDivRef">
            <!-- Zeitachsn Balken -->
            <div class="movable-layer" style="width:@(movableLayerWidth)px; position: relative;">

                @foreach (var entry in visibleEntries)
                {
                    <div @key="entry.Index" class="timestamp" style="left:@($"{entry.Position}px")">
                        <span>
                            @entry.Time.ToString(
                                     SecondsPerSpacing < 60 ? "yyyy-MM-dd HH:mm:ss" :      // Sekunden bis Minuten
                                     SecondsPerSpacing < 3600 ? "yyyy-MM-dd HH:mm" :        // Minuten bis Stunden
                                     SecondsPerSpacing < 86400 ? "yyyy-MM-dd HH:mm" :       // Stunden bis 24 Stunden
                                     SecondsPerSpacing < 2592000 ? "yyyy-MM-dd" :            // Ab 30 Tagen auf "yyyy-MM-dd"
                                     SecondsPerSpacing < 31536000 ? "yyyy-MM" :               // Ab 2 Monaten auf "yyyy-MM"
                                     "yyyy"                                                       // Ab 1 Jahr auf "yyyy-MM"
                                     )
                        </span>
                    </div>
                    <div class="line" style="left:@($"{entry.Position}px")"></div>
                }
  
            </div>


            <!-- History Einträge in der Zeitachse -->
            @foreach (var data in State.BrowserEntries)
            {
                if (data.Position > -50 && data.Position < viewportWidth - 300)
                {
                    <div class="history-marker"
                         style="left: calc(@($"{data.Position}px - 5px"))"
                         data-url="@data.Url"
                         data-time="@data.VisitTime"
                         @onclick="() => selectedEntry = data">
                    </div>
                }
            }
            @if (selectedEntry != null)
            {
                <div class="entry-details">
                    <p><strong>Besuchszeit:</strong> @selectedEntry.VisitTime</p>
                    <p><strong>URL:</strong> @selectedEntry.Url</p>
                    @if (!string.IsNullOrEmpty(selectedEntry.Title))
                    {
                        <p><strong>Titel:</strong> @selectedEntry.Title</p>
                    }
                </div>
            }

            <!-- Cookies Einträge in der Zeitachse -->
            @foreach (var cookie in State.BrowserCookies)
            {
                if (cookie.Position > -50 && cookie.Position < viewportWidth - 300)
                {
                    <div class="cookie-marker"
                         style="left: calc(@($"{cookie.Position}px - 5px"))"
                         data-host="@cookie.Host"
                         data-time="@cookie.LastAccessed"
                         @onclick="() => selectedCookie = cookie">
                    </div>
                }
            }

            @if (selectedCookie != null)
            {
                <div class="entry-details cookie-details">
                    <p><strong>Host:</strong> @selectedCookie.Host</p>
                    <p><strong>Name:</strong> @selectedCookie.Name</p>
                    <p><strong>Created:</strong> @selectedCookie.Created</p>
                    <p><strong>Last Accessed:</strong> @selectedCookie.LastAccessed</p>
                    <p><strong>Expires:</strong> @selectedCookie.Expires</p>
                </div>
            }


        </div>
    </div>
</div>
