    private string GetTopFindings(BrowserExtensionEntry ext)
    {
        return string.Join(" | ",
            ext.Findings
               .OrderByDescending(f => f.Weight)
               .Take(2)
               .Select(f => f.Description));
    }

    private string TrimLabel(string text, int maxLength = 40)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        return text.Length > maxLength
            ? text.Substring(0, maxLength) + "..."
            : text;
    }

    private string GetFocusedArtifactLabel()
    {
        var artifact = GetVisualFocusedArtifact();

        if (artifact == null)
            return "";

        return artifact.Data switch
        {
            BrowserHistoryEntry h => TrimLabel(h.Url),
            BrowserCookieEntry c => TrimLabel(c.Name),
            UserInputEntry i => TrimLabel(i.Value),
            BrowserExtensionEntry e => TrimLabel(e.Name),
            StorageEntry s => TrimLabel(s.Value),
            AnalysisEntry a => TrimLabel(a.Type.ToString()),
            _ => ""
        };
    }

    private int GetFocusedArtifactPosition()
    {
        var artifact = GetVisualFocusedArtifact();

        if (artifact == null)
            return 0;

        return artifact.Data switch
        {
            BrowserHistoryEntry h => h.Position,
            BrowserCookieEntry c => c.Position,
            UserInputEntry i => i.Position,
            BrowserExtensionEntry e => e.Position,
            StorageEntry s => s.Position,
            AnalysisEntry a => a.Position,
            _ => 0
        };
    }

    private string GetFocusedArtifactYPixel()
    {
        var artifact = GetVisualFocusedArtifact();

        if (artifact == null)
            return "20%";

        return artifact.Data switch
        {
            BrowserHistoryEntry => "33%",
            BrowserCookieEntry => "43%",
            UserInputEntry => "50%",
            StorageEntry => "57%",
            BrowserExtensionEntry => "64%",
            AnalysisEntry => "78%",
            _ => "20%"
        };
    }

