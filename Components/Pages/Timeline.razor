    private async Task UpdateViewportSizeAsync()
    {
        viewportWidth = Math.Max(await JS.InvokeAsync<int>("getViewportWidth"), 300);

        // Für SVG Rendering
        containerHeight = await JS.InvokeAsync<int>("getElementHeight", "scroll-container");

    }

    // Nur Zeitstempel betreffend
    private void UpdateVisibleTimestamps()
    {
        int centerIndex = (int)((scrollIndex - InitialOffsetPx) / spacing);
        int firstVisibleIndex = (int)((scrollIndex - InitialOffsetPx) / spacing) - renderBuffer;
        int lastVisibleIndex = firstVisibleIndex + (int)(viewportWidth / spacing) + 2 * renderBuffer;


        visibleEntries = new();
        for (int i = firstVisibleIndex; i <= lastVisibleIndex; i++)
        {
            var entry = CreateEntry(i);
            entry.Position = InitialOffsetPx + i * spacing;            // direktes Positionieren, scrollBar sorgt für Bewegung
            visibleEntries.Add(entry);
        }

        //NEU: width so setzen, dass auch negative Einträge Platz haben
        int minIndex = firstVisibleIndex;
        int maxIndex = lastVisibleIndex;

        //Optional: baseOffset setzen, um negative Indexe sichtbar zu machen
        startOffset = -minIndex * spacing + 250; // z. B. 250px Puffer nach links
    }


    // Nur für Einträge in der Zeitachse
    private void RecalculatePositions()
    {
        // Wird für jeden Eintrag gemacht
        foreach (var historyEntry in State.BrowserEntries)
        {
            historyEntry.Position = (int)TimeToPixel(historyEntry.VisitTime) - scrollIndex; //Hier geht was schief wenn die position mit dsem zoom nicht stimmt
        }
    }

    private void RecalculateCookiePositions()
    {
        if (State.BrowserCookies == null) return;

        foreach (var cookie in State.BrowserCookies)
        {
            cookie.Position = (int)TimeToPixel(cookie.Created) - (int)scrollIndex;
        }
    }

    private void RecalculateUserInputPositions()
    {
        if (UserInputs == null) return;

        foreach (var entry in UserInputs)
        {
            entry.Position = (int)TimeToPixel(entry.Time) - (int)scrollIndex;
        }
    }

    private void RecalculateSummarizedPositions()
    {
        if (SummarizedEntries == null) return;

        foreach (var entry in SummarizedEntries)
        {
            entry.Position = (int)TimeToPixel(entry.VisitTime) - (int)scrollIndex;
        }
    }

    private void RecalculateExtensionPositions()
    {
        if (State.Extensions == null) return;

        foreach (var ext in State.Extensions)
        {
            ext.Position = (int)TimeToPixel(ext.InstallTime) - (int)scrollIndex;
        }
    }

    private void RecalculateStoragePositions()
    {
        if (State.StorageEntries == null) return;

        foreach (var entry in State.StorageEntries)
        {
            entry.Position = (int)TimeToPixel(entry.Time) - (int)scrollIndex;
        }
    }

    void RecalculateAnomalyPositions()
    {
        foreach (var a in Anomalies)
        {
            DateTime positionTime;

            switch (a.Type)
            {
                case AnomalyType.DeletedHistoryIndicator:
                    // 🔥 exakt am Artefakt
                    positionTime = a.FirstSeen;
                    break;

                default:
                    // 🔁 Mittelwert bei echten Zeitspannen
                    if (a.FirstSeen == a.LastSeen)
                    {
                        positionTime = a.FirstSeen;
                    }
                    else
                    {
                        long ticks = (a.FirstSeen.Ticks + a.LastSeen.Ticks) / 2;
                        positionTime = new DateTime(ticks);
                    }
                    break;
            }

            a.Position = (int)TimeToPixel(positionTime) - (int)scrollIndex;
        }
    }



