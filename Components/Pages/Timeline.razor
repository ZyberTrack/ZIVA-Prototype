                                        top:6px;
                                        right:6px;
                                        background:@GetSeverityColor(e.HighestAnomalySeverity);
                                        color:white;
                                        font-size:10px;
                                        font-weight:700;
                                        padding:1px 6px;
                                        border-radius:999px;
                                        box-shadow:0 0 6px rgba(0,0,0,0.25);">

                                        @e.HighestAnomalySeverity
                                    </div>
                                }
                                @e.VisitTime <br />
                                @(e.Url?.Length > 90
                                    ? e.Url.Substring(0, 90) + "..."
                                    : e.Url)

                                <br />
                                px=@e.Position

                            </li>
                        }
                    </ul>
                </div>

                <div class="artifact-column">
                    <strong>Cookies (@State.BrowserCookies.Count)</strong>

                    <ul>
                        @foreach (var e in State.BrowserCookies)
                        {
                            <li class="artifact-clickable artifact-anomaly"
                                style="@GetArtifactStyle(e)"
                                @onclick="() => SelectCookie(e)"
                                @oncontextmenu="args => OpenContextMenu(args, e)"
                                @oncontextmenu:preventDefault="true">
                                @if (e.HighestAnomalySeverity > 0)
                                {
                                    <div style="
                                        position:absolute;
                                        top:6px;
                                        right:6px;
                                        background:@GetSeverityColor(e.HighestAnomalySeverity);
                                        color:white;
                                        font-size:10px;
                                        font-weight:700;
                                        padding:1px 6px;
                                        border-radius:999px;
                                        box-shadow:0 0 6px rgba(0,0,0,0.25);">

                                        @e.HighestAnomalySeverity
                                    </div>
                                }
                                @e.Name <br />
                                @(e.Value?.Length > 80 ? e.Value.Substring(0, 80) + "..." : e.Value) <br />
                                @e.LastAccessed <br />
                                px=@e.Position

                            </li>
                        }
                    </ul>
                </div>

                <div class="artifact-column">
                    <strong>User Input (@UserInputs.Count)</strong>

                    <ul>
                        @foreach (var e in UserInputs)
                        {
                            <li class="artifact-clickable artifact-anomaly"
                                style="@GetArtifactStyle(e)"
                                @onclick="() => SelectInput(e)"
                                @oncontextmenu="args => OpenContextMenu(args, e)"
                                @oncontextmenu:preventDefault="true">
                                @if (e.HighestAnomalySeverity > 0)
                                {
                                    <div style="
                                        position:absolute;
                                        top:6px;
                                        right:6px;
                                        background:@GetSeverityColor(e.HighestAnomalySeverity);
                                        color:white;
                                        font-size:10px;
                                        font-weight:700;
                                        padding:1px 6px;
                                        border-radius:999px;
                                        box-shadow:0 0 6px rgba(0,0,0,0.25);">

                                        @e.HighestAnomalySeverity
                                    </div>
                                }
                                @e.Type <br />

                                @(e.Value?.Length > 100
                                    ? e.Value.Substring(0, 100) + "..."
                                    : e.Value)

                                <br />

                                @e.Time <br />
                                px=@e.Position

                            </li>
                        }
                    </ul>
                </div>

                <div class="artifact-column">
                    <strong>Extensions (@State.Extensions.Count)</strong>

                    <ul>
                        @foreach (var e in State.Extensions)
                        {
                            <li class="artifact-clickable artifact-anomaly"
                                style="@GetArtifactStyle(e)"
                                @onclick="() => SelectExtension(e)"
                                @oncontextmenu="args => OpenContextMenu(args, e)"
                                @oncontextmenu:preventDefault="true">
                                @if (e.HighestAnomalySeverity > 0)
                                {
                                    <div style="
                                        position:absolute;
                                        top:6px;
                                        right:6px;
                                        background:@GetSeverityColor(e.HighestAnomalySeverity);
                                        color:white;
                                        font-size:10px;
                                        font-weight:700;
                                        padding:1px 6px;
                                        border-radius:999px;
                                        box-shadow:0 0 6px rgba(0,0,0,0.25);">

                                        @e.HighestAnomalySeverity
                                    </div>
                                }
                                <strong>@e.Name</strong><br />

                                @e.InstallTime <br />

                                px=@e.Position

                            </li>
                        }
                    </ul>
                </div>

                <div class="artifact-column">
                    <strong>Storage (@State.StorageEntries.Count)</strong>

                    <ul>
                        @foreach (var s in State.StorageEntries)
                        {
                            <li class="artifact-clickable artifact-anomaly"
                                style="@GetArtifactStyle(s)"
                                @onclick="() => SelectStorage(s)"
                                @oncontextmenu="args => OpenContextMenu(args, s)"
                                @oncontextmenu:preventDefault="true">
                                @if (s.HighestAnomalySeverity > 0)
                                {
                                    <div style="
                                        position:absolute;
                                        top:6px;
                                        right:6px;
                                        background:@GetSeverityColor(s.HighestAnomalySeverity);
                                        color:white;
                                        font-size:10px;
                                        font-weight:700;
                                        padding:1px 6px;
                                        border-radius:999px;
                                        box-shadow:0 0 6px rgba(0,0,0,0.25);">

                                        @s.HighestAnomalySeverity
                                    </div>
                                }
                                <strong>@s.Key</strong><br />

                                Type: @s.Type <br />

                                Value:
                                @(s.Value?.Length > 80
                                    ? s.Value.Substring(0, 80) + "..."
                                    : s.Value)

                                <br />

                                px=@s.Position

                            </li>
                        }
                    </ul>
                </div>

                <div class="artifact-column">
                    <strong>Domains (@DomainEntries.Count)</strong>

                    <ul>
                        @foreach (var d in DomainEntries)
                        {
                            <li class="artifact-clickable artifact-anomaly"
                                style="@GetArtifactStyle(d)"
                                @onclick="() => ExpandAndFocus(d)"
                                @oncontextmenu="args => OpenContextMenu(args, d)"
                                @oncontextmenu:preventDefault="true">
                                @if (d.HighestAnomalySeverity > 0)
                                {
                                    <div style="
                                        position:absolute;
                                        top:6px;
                                        right:6px;
                                        background:@GetSeverityColor(d.HighestAnomalySeverity);
                                        color:white;
                                        font-size:10px;
                                        font-weight:700;
                                        padding:1px 6px;
                                        border-radius:999px;
                                        box-shadow:0 0 6px rgba(0,0,0,0.25);">

                                        @d.HighestAnomalySeverity
                                    </div>
                                }
                                <strong>@d.Domain</strong><br />

                                URL:
                                @(d.Url?.Length > 90
                                    ? d.Url.Substring(0, 90) + "..."
                                    : d.Url)

                                <br />

                                Visits: @(d.SubEntries?.Count ?? 0) <br />

                                px=@d.Position

                            </li>
                        }
                    </ul>
                </div>

                <div class="artifact-column">
                    <strong>Analyse Zeitachse (@AnalysisEntries.Count)</strong>

                    <ul>
                        @foreach (var a in AnalysisEntries)
                        {
                            <li class="artifact-clickable artifact-anomaly"
                                style="@GetArtifactStyle(a)"
                                @onclick="() => FocusAnomaly(a)"
                                @oncontextmenu="args => OpenContextMenu(args, a)"
                                @oncontextmenu:preventDefault="true">
                                @if (a.Severity > 0)
                                {
                                    <div style="
                                        position:absolute;
                                        top:6px;
                                        right:6px;
                                        background:@GetSeverityColor(a.Severity);
                                        color:white;
                                        font-size:10px;
                                        font-weight:700;
                                        padding:1px 6px;
                                        border-radius:999px;
                                        box-shadow:0 0 6px rgba(0,0,0,0.25);">

                                        @a.Severity
                                    </div>
                                }
                                <span style="
                                    color:@ColorService.GetAnalysisColor(a);
                                    font-weight:700;
                                    font-size:14px;">
                                    @a.Type
                                </span>
                                <br />
                                px=@Math.Round((decimal)a.Position, 1)
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </div>
    }

    

    <!-- LEFT SIDE OF TIMELINE -->
    <div class="legend-area @(isNavOpen ? "shifted" : "full")">
        <div class="timeline-area-static timeline-area-top">
            <div class="timeline-label @(isNavOpen ? "sidebar-open" : "sidebar-closed")">
            Verlauf-Zeitachse
            </div>

            <div class="timeline-history-label">URL Verlauf</div>
            <div class="timeline-top-legend "></div>
            <div class="timeline-cookies-label">Cookies & Sitzungen</div>
            <div class="timeline-cookies"></div>
            <div class="timeline-webdata-label">Benutzer Eingaben</div>
            <div class="timeline-webdata"></div>
            <div class="timeline-favicons-label">Lokaler Speicher </div>
            <div class="timeline-favicons"></div>
            <div class="timeline-ext-label">Erweiterungen</div>
            <div class="timeline-ext"></div>
        </div>
        <div class="timeline-area-static timeline-area-bottom">
            <div class="timeline-label">Analyse-Zeitachse</div>

            <div class="timeline-analysis-anomaly-label">Anomalien</div>
            <div class="timeline-analysis-warning-label">Warnungen</div>
            <div class="timeline-analysis-info-label">Infos</div>

            <div class="timeline-bottom-legend"></div>
            <div class="timeline-bottom-warning-legend"></div>
            <div class="timeline-bottom-info-legend"></div>
        </div>
    </div>

    <!-- MOVABLE TIMELINE -->
    <div class="timeline-static">
        <div class="timeline-area-scroll timeline-area-top">
            <div class="timeline-top"></div>
            <div class="timeline-cookies"></div>
            <div class="timeline-webdata"></div>
            <div class="timeline-favicons"></div>
            <div class="timeline-ext"></div>
        </div>

        <div class="timeline-area-scroll timeline-area-bottom @(showDebug ? "artifact-open" : "")">
            <div class="timeline-bottom"></div>
            <div class="timeline-bottom-warning"></div>
            <div class="timeline-bottom-info"></div>

            


        </div>
    </div>

    <!-- RIGHT SIDE OF TIMELINE -->
    <div class="timeless-area">


        <div class="timeless-header">
            TOOLS
        </div>

        <button class="tool-btn debug-btn"
                @onclick="ToggleDebug">
            @(showDebug ? "Artefakt Tabelle aus" : "Artefakt Tabelle An")
        </button>

        <button class="tool-btn"
                @onclick="ToggleLegend">
            @(showLegend ? "Legende Aus" : "Legende An")
        </button>

    </div>


    <div class="timeline-container" @oncontextmenu="args => OpenContextMenu(args)" @oncontextmenu:preventDefault="true" @onclick="ClearVisualFocus">

        @if (showLegend)
        {
            <div class="timeline-legend">

                <div class="legend-title">
                    Legende
                </div>

                <div class="legend-item">
                    <div class="legend-square"></div>
                    <span><strong>Suchanfrage</strong></span>
                </div>

                <div class="legend-item">
                    <svg class="legend-marker"
                         width="16"
                         height="22"
                         viewBox="0 0 16 22">
                        <polygon points="0,0 16,0 8,22"
                                 fill="currentColor" />
                    </svg>

                    <span><strong>Subdomain</strong>: Verwiesener Aufruf</span>
                </div>

                <div class="legend-item">
                    <svg class="legend-marker"
                         width="16"
                         height="22"
                         viewBox="0 0 16 22">
                        <polygon points="0,0 16,0 8,22"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2" />
                    </svg>

                    <span><strong>Subdomain</strong>: Direkter Aufruf</span>
                </div>

            </div>
        }

        <div class="timeline-search">

            <div class="search-toolbar">

                <input type="text"
                       placeholder="Suche..."
                       @bind="SearchText"
                       @bind:event="oninput" />

                <button @onclick="PreviousSearchResult">
                    ◀
                </button>

                <button @onclick="NextSearchResult">
                    ▶
                </button>

                <div class="search-counter">
                    @(SearchResults.Count == 0
                        ? "-"
                        : $"{CurrentSearchIndex + 1}/{SearchResults.Count}")
                </div>

            </div>

            <div class="timeline-domain-filter">

                <select @bind="SelectedDomainFilter">
                    <option value="">Filter: Alle Domänen</option>

                    @foreach (var domain in AvailableDomains)
                    {
                        <option value="@domain">@domain</option>
                    }
                </select>

                <label class="navigation-path-toggle">
                    <input type="checkbox"
                       @bind="IncludeNavigationPaths"
                       @bind:after="ApplyDomainFilter" />

                    Inkl. Relationen
                </label>

            </div>

            <div class="artifact-filter">

                <label>
                    <input type="checkbox"
                           @bind="ShowHistory"
                           @bind:after="ApplyDomainFilter" />
                    Verlauf
                </label>

                <label>
                    <input type="checkbox"
                           @bind="ShowCookies"
                           @bind:after="ApplyDomainFilter" />
                    Cookies
                </label>

                <label>
                    <input type="checkbox"
                           @bind="ShowInputs"
                           @bind:after="ApplyDomainFilter" />
                    Eingaben
                </label>

                <label>
                    <input type="checkbox"
                           @bind="ShowStorage"
                           @bind:after="ApplyDomainFilter" />
                    Storage
                </label>

                <label>
                    <input type="checkbox"
                           @bind="ShowExtensions"
                           @bind:after="ApplyDomainFilter" />
                    Erweiterungen
                </label>

            </div>

            <div class="analysis-filter">

                <label>
                    <input type="checkbox"
                           @bind="ShowInformation"
                           @bind:after="ApplyDomainFilter" />
                    Infos
                </label>

                <label>
                    <input type="checkbox"
                           @bind="ShowWarnings"
                           @bind:after="ApplyDomainFilter" />
                    Warnungen
                </label>

                <label>
                    <input type="checkbox"
                           @bind="ShowAnomalies"
                           @bind:after="ApplyDomainFilter" />
                    Anomalien
                </label>

            </div>

            @if (SearchResults.Any())
            {
                <div class="search-results-list">

                    @for (int i = 0; i < SearchResults.Count; i++)
                    {
                        var index = i;
                        var result = SearchResults[index];

                        <div class="search-result-item
                            @(i == CurrentSearchIndex ? "active" : "")"
                             @onclick="() => SelectSearchResult(index)">

                            @result.DisplayText

                        </div>
                    }

                </div>
            }


        </div>

        

        <!-- Externer Container mit fixer Breite & overflow -->
        <div id="scroll-container" class="scroll-wrapper scroll-wrapper-timeline" @ref="scrollDivRef">
            <!-- Zeitachsn Balken -->
            <div class="movable-layer" style="width:@(movableLayerWidth)px; position: relative;">

                @foreach (var entry in visibleEntries)
                {
                    <div @key="entry.Index" class="timestamp" style="left:@($"{entry.Position}px")">
                        <span>
                            @entry.Time.ToString(
                                     SecondsPerSpacing < 60 ? "yyyy-MM-dd HH:mm:ss" :      // Sekunden bis Minuten
                                     SecondsPerSpacing < 3600 ? "yyyy-MM-dd HH:mm" :        // Minuten bis Stunden
                                     SecondsPerSpacing < 86400 ? "yyyy-MM-dd HH:mm" :       // Stunden bis 24 Stunden
                                     SecondsPerSpacing < 2592000 ? "yyyy-MM-dd" :            // Ab 30 Tagen auf "yyyy-MM-dd"
                                     SecondsPerSpacing < 31536000 ? "yyyy-MM" :               // Ab 2 Monaten auf "yyyy-MM"
                                     "yyyy"                                                       // Ab 1 Jahr auf "yyyy-MM"
                                     )
                        </span>
                    </div>
                    <div class="line" style="left:@($"{entry.Position}px")"></div>
                }
  
            </div>


            <!-- History Einträge in der Zeitachse -->
            @{
                int baseTop = 33; // Basislinie für normale Domains in %
                int heavyClusterSpacingPx = 20; // Abstand jeder neuen Heavy Cluster-Linie nach oben
            }

            <!-- Überschrift über focused artefact -->
            @if(GetVisualFocusedArtifact() != null)
            {
                <div class="focused-artifact-label"
                     style="
                    left:@($"{GetFocusedArtifactPosition()}px");
                    top:20%;">

                    @GetFocusedArtifactLabel()

                </div>
            }

            @if (GetVisualFocusedArtifact() != null && visualFocusedArtifact.Data is not BrowserHistoryEntry && visualFocusedArtifact.Data is not DomainEntry)
            {
                <svg style="
                    position:absolute;
                    left:0;
                    top:0;
                    width:100%;
                    height:100%;
                    pointer-events:none;
                    z-index:39;">

                    <line x1="@GetFocusedArtifactPosition()"
                          y1="22%"
                          x2="@GetFocusedArtifactPosition()"
                          y2="@GetFocusedArtifactYPixel()"
                          stroke="black"
                          stroke-width="1.5"
                          opacity="0.5" />

                </svg>
            }

            @foreach (var domainEntry in DomainEntries.Where(d => d.IsHeavyCluster))
            {
                string topStyle = $"calc({baseTop}% - 18px - {domainEntry.HeavyClusterIndex * heavyClusterSpacingPx}px)";

                double offsetPx = 25 + heavyClusterSpacingPx * (domainEntry.HeavyClusterIndex - 1);

                double offsetPercent = (offsetPx / containerHeight) * 100.0;

                domainEntry.RenderYPercent = Math.Round(baseTop - offsetPercent);

                int start;
                int end;

                if (AnyFilterActive)
                {
                    var visible = domainEntry.SubEntries
                        .Where(RenderCache.VisibleHistory.Contains)
                        .OrderBy(h => h.Position)
                        .ToList();

                    if (visible.Count < 10)
                    {
                        continue;
                    }

                    start = visible.First().Position;
                    end = visible.Last().Position;
                }
                else
                {
                    start = domainEntry.ClusterStartPosition;
                    end = domainEntry.ClusterEndPosition;
                }

                for (int x = start; x < end; x += MaxSegment)
                {
                    int segmentWidth = Math.Min(MaxSegment, end - x);

                    <div class="heavy-cluster-line"
                         style="
                            position:absolute;
                            top:@($"calc({baseTop}% - 7px - {domainEntry.HeavyClusterIndex * heavyClusterSpacingPx}px)");
                            left:@($"{x}px");
                            width:@($"{segmentWidth}px");
                            height:2px;
                            background-color:@domainEntry.RenderColor;
                            z-index:20;">
                    </div>
                }
            }

            @foreach (var domainEntry in RenderCache.VisibleDomains)
            {
                <div class="domain-container">

                    @{
                        bool isHeavy = domainEntry.IsHeavyCluster;

                        if (AnyFilterActive)
                        {
                            var visible = domainEntry.SubEntries
                                .Where(RenderCache.VisibleHistory.Contains)
                                .ToList();

                            isHeavy &= visible.Count >= 10;
                        }

                        string topStyle = $"calc({baseTop}% - 12px)";
                        string topStyleSquare = $"calc({baseTop}% + 5px)";

                        domainEntry.RenderYPercent = baseTop;

                        if (isHeavy)
                        {
                            topStyle = $"calc({baseTop}% - 18px - {domainEntry.HeavyClusterIndex * heavyClusterSpacingPx}px)";

                            double offsetPx =
                                25 + heavyClusterSpacingPx * (domainEntry.HeavyClusterIndex - 1);

                            double offsetPercent =
                                (offsetPx / containerHeight) * 100.0;

                            domainEntry.RenderYPercent =
                                Math.Round(baseTop - offsetPercent);
                        }

                        // SubEntries anzeigen
                        foreach (var sub in domainEntry.SubEntries.Where(RenderCache.VisibleHistory.Contains))
                        {
                            bool isSearch = sub.Url.Contains("google.") || sub.Url.Contains("bing.com") || sub.Url.Contains("duckduckgo.com");

                            <div class="subentry"
                                 style="position: absolute;
                            left: calc(@($"{sub.Position}px - 6px"));
                            top:calc(@topStyle);
                                color:@ColorService.GetColor(sub.Url);
                            cursor:pointer;
                            z-index:21;"
                             @onclick="() => SelectSubEntry(domainEntry, sub)"
                                 @onclick:stopPropagation="true"
                                 @oncontextmenu="args => OpenContextMenu(args, sub)"
                                 @oncontextmenu:preventDefault="true"
                                 @oncontextmenu:stopPropagation="true">

                                @if (isSearch)
                                {
                                    // Suchmaschine = Quadrat
                                    <div class="domain-marker square"
                                         style="
                                        width:20px;
                                        height:20px;
                                        color:@ColorService.GetColor(sub.Url);
                                        top:calc(@topStyleSquare);
                                        @GetMarkerFocusStyle(sub)">
                                    </div>
                                }
                                else if (string.IsNullOrEmpty(sub.ReferrerUrl))
                                {
                                    // Direkter Aufruf = hohl
                                    <svg width="22"
                                         height="22"
                                         viewBox="0 0 22 22"
                                         style="@GetMarkerFocusStyle(sub)">

                                        <polygon points="0,0 22,0 11,22"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linejoin="round" />
                                    </svg>
                                }
                                else
                                {
                                    // Über Referrer geöffnet = gefüllt
                                    <svg width="22"
                                         height="22"
                                         viewBox="0 0 22 22"
                                         style="@GetMarkerFocusStyle(sub)">

                                        <polygon points="0,0 22,0 11,22"
                                                 fill="currentColor" />
                                    </svg>
                                }

                                <div class="subentry-tooltip" style="background-color:@domainEntry.RenderColor;">
                                    <div><strong>Zeitstempel: @sub.VisitTime</strong></div>
                                    <div>URL: @ShortUrl(sub.Url)</div>
                                    @if (!string.IsNullOrEmpty(sub.ReferrerUrl))
                                    {
                                        <div>Verwiesen von: @ShortUrl(sub.ReferrerUrl)</div>
                                    }
                                </div>
                            </div>

                            @if (IsFocused(sub))
                            {
                                <svg style="
                                    position:absolute;
                                    left:0;
                                    top:0;
                                    width:100%;
                                    height:100%;
                                    pointer-events:none;
                                    z-index:39;">

                                    <line x1="@sub.Position"
                                          y1="22%"
                                          x2="@sub.Position"
                                          y2="@topStyle"
                                          stroke="black"
                                          stroke-width="1.5"
                                          opacity="0.5" />

                                </svg>
                            }

                        }

                    }
                </div>
            }





            <!-- Cookies Einträge in der Zeitachse -->
            @foreach (var cookie in RenderCache.VisibleCookies)
            {
                <div class="cookie-marker"
                     style="
                    left: calc(@($"{cookie.Position + 8}px - 5px"));
                    --marker-color:@ColorService.GetCookieColor(cookie.Category);
                    color:@ColorService.GetCookieColor(cookie.Category);
                    @GetFocusedStyle(cookie)"
                     data-name="@ShortUrl(cookie.Name)"
                     data-category="@cookie.Category"
                         data-host="@ShortUrl(cookie.Host)"
                         data-valueEncr="@cookie.EncryptedValue"
                         data-value="@ShortUrl(cookie.Value)"
                         data-time="@cookie.Created"
                     @onclick="() => SelectCookie(cookie)"
                     @onclick:stopPropagation="true"
                     @oncontextmenu="args => OpenContextMenu(args, cookie)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">
                    </div>
            }



            <!-- User Input Einträge in der Zeitachse -->
            @foreach (var item in RenderCache.VisibleInputs)
        {
                string cssClass = item.Type switch
                {
                    UserInputType.SearchQuery => "search",
                    UserInputType.Autofill => "autofill",
                    UserInputType.Favicon => "favicon",
                    _ => ""
                };

                <div class="userinput-marker @cssClass"
                     style="left: calc(@($"{item.Position + 8}px - 5px"));
                    @GetFocusedStyle(item)"
                     data-value="@ShortUrl(item.Value)"
                     data-time="@item.Time"
                     data-type="@item.Type"
                     @onclick="() => SelectInput(item)"
                     @onclick:stopPropagation="true"
                     @oncontextmenu="args => OpenContextMenu(args, item)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">
                </div>
        }


        <!-- Extensions in der Zeitachse -->
            @foreach (var ext in RenderCache.VisibleExtensions)
        {
                <div class="extension-marker"
                     style="left: calc(@($"{ext.Position + 8}px - 5px"));
                    @GetFocusedStyle(ext)"
                     data-name="@ext.Name"
                     data-risk="@ext.RiskLevel"
                     data-score="@ext.RiskScore"
                     data-findings="@GetTopFindings(ext)"
                     data-time="@ext.InstallTime"
                     @onclick="() => SelectExtension(ext)"
                     @onclick:stopPropagation="true"
                     @oncontextmenu="args => OpenContextMenu(args, ext)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">
                </div>
        }

        <!-- STORAGE Einträge in der Zeitachse -->
            @foreach (var s in RenderCache.VisibleStorage)
        {
                <div class="storage-marker @(s.IsSensitive ? "sensitive" : "")"
                     style="left: calc(@($"{s.Position + 8}px - 5px"));
                    @GetFocusedStyle(s)"
                     data-key="@s.Key"
                     data-origin="@ShortUrl(s.Origin)"
                     data-value="@ShortUrl(s.Value)"
                     @onclick="() => SelectStorage(s)"
                     @onclick:stopPropagation="true"
                     @oncontextmenu="args => OpenContextMenu(args, s)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">
                </div>
        }


            <!-- RELATION LINES -->
            <svg style="
                position:absolute;
                left:0;
                top:0;
                width:100%;
                height:100%;
                pointer-events:none;
                z-index:18;">


                <defs>
                    <marker id="historyArrow"
                            viewBox="0 0 12 12"
                            refX="11"
                            refY="6"
                            markerWidth="7"
                            markerHeight="7"
                            orient="auto">

                        <path d="M0,2 L11,6 L0,10"
                              fill="none"
                              stroke="context-stroke"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                    </marker>
                </defs>

                @foreach (var cookie in RenderCache.VisibleCookies)
                {
                    foreach (var relation in cookie.Relations)
                    {
                        if (relation.History == null)
                            continue;

                        var history = relation.History;

                        string color =
                            ColorService.GetColor(history.Url);

                        double historyPosX = history.Position;

                        double historyPosY = history.ParentDomain?.RenderYPercent ?? baseTop;

                        double cookiePosX = cookie.Position - 2 + 8;

                        double cookiePosY = 43;

                        <line x1="@historyPosX"
                              y1="@($"{historyPosY}%")"
                              x2="@cookiePosX"
                              y2="@($"{cookiePosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }

              

                @foreach (var input in RenderCache.VisibleInputs)
                {
                    foreach (var relation in input.Relations)
                    {
                        if (relation.History == null)
                            continue;

                        var history = relation.History;

                        string color =
                            ColorService.GetColor(history.Url);

                        double historyPosX = history.Position;

                        double historyPosY = history.ParentDomain?.RenderYPercent ?? baseTop;

                        double inputPosX = input.Position - 2 + 8;

                        double inputPosY =
                            input.Type switch
                            {
                                UserInputType.Autofill => 50,
                                UserInputType.Favicon => 50,
                                _ => 50
                            };

                        <line x1="@historyPosX"
                              y1="@($"{historyPosY}%")"
                              x2="@inputPosX"
                              y2="@($"{inputPosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }

                @foreach (var ext in RenderCache.VisibleExtensions)
                {
                    foreach (var relation in ext.Relations)
                    {
                        if (relation.Type != ArtifactRelationType.ExtensionToWebStore)
                            continue;

                        if (relation.History == null)
                            continue;

                        var history = relation.History;

                        string color =
                            ColorService.GetColor(history.Url);

                        double historyPosX = history.Position;

                        double historyPosY = history.ParentDomain?.RenderYPercent ?? baseTop;

                        double extPosX = ext.Position + 8;
                        double extPosY = 64;

                        <line x1="@historyPosX"
                              y1="@($"{historyPosY}%")"
                              x2="@extPosX"
                              y2="@($"{extPosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }

                @foreach (var storage in RenderCache.VisibleStorage)
                {
                    foreach (var relation in storage.Relations)
                    {
                        if (relation.History == null)
                            continue;

                        var history = relation.History;

                        string color =
                            ColorService.GetColor(history.Url);

                        double historyPosX = history.Position;

                        double historyPosY = history.ParentDomain?.RenderYPercent ?? baseTop;

                        double storagePosX =
                            storage.Position + 8;

                        double storagePosY = 57;

                        <line x1="@historyPosX"
                              y1="@($"{historyPosY}%")"
                              x2="@storagePosX"
                              y2="@($"{storagePosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }


                @foreach (var domain in DomainEntries)
                {
                    foreach (var history in domain.SubEntries)
                    {
                        foreach (var relation in history.Relations)
                        {
                            if (relation.Type != ArtifactRelationType.HistoryReferrer)
                                continue;

                            if (relation.History == null)
                                continue;

                            // Nur zeichnen wenn mindestens eine Seite sichtbar ist
                            bool sourceVisible =
                                RenderCache.VisibleHistory.Contains(relation.History);

                            bool targetVisible =
                                RenderCache.VisibleHistory.Contains(history);

                            if (!sourceVisible && !targetVisible)
                                continue;

                            var sourceDomain = GetRenderedDomain(relation.Domain);

                            if (sourceDomain == null)
                                continue;

                            string color = ColorService.GetColor(sourceDomain.Url);

                            <line x1="@relation.History.Position"
                                  y1="@($"{sourceDomain.RenderYPercent}%")"
                                  x2="@history.Position"
                                  y2="@($"{domain.RenderYPercent}%")"
                                  stroke="@color"
                                  stroke-width="2"
                                  opacity="0.35"
                                  stroke-linecap="round"
                                  marker-end="url(#historyArrow)" />
                        }
                    }
                }
            </svg>
            

            @foreach (var analysis in RenderCache.VisibleAnomalies)
            {
                var color = ColorService.GetAnalysisColor(analysis);

                string top = analysis.Category switch
                {
                    AnalysisCategory.Anomaly => $"{AnomalyYPercent}%",
                    AnalysisCategory.Warning => $"calc({AnomalyYPercent}% + 5%)",
                    AnalysisCategory.Information => $"calc({AnomalyYPercent}% + 11%)",
                    _ => $"{AnomalyYPercent}%"
                };

                <div class="anomaly-marker"
                     style="position:absolute;
                    left:@($"{analysis.Position - 6 + 8}px");
                    top:@top;
                    transform:translateY(-50%);
                    color:@color;
                    z-index:30;"
                     data-category="@analysis.Category"
                     data-time="@analysis.FirstSeen"
                     data-lastseen="@analysis.LastSeen"
                     data-url="@analysis.Url"
                     data-type="@analysis.Type"
                     data-description="@analysis.Description"
                     data-severity="@analysis.Severity"
                     data-count="@analysis.Count"
                     @onclick="() => FocusAnomaly(analysis)"
                     @onclick:stopPropagation="true"
                     @oncontextmenu="args => OpenContextMenu(args, analysis)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">

                    <div style="
                        width:@($"{10 + analysis.Severity * 2}px");
                        height:@($"{10 + analysis.Severity * 2}px");
                        border-radius:50%;
                        background:currentColor;">
                    </div>

                </div>
            }

            <svg style="position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; z-index:15;">


            @foreach (var analysis in RenderCache.VisibleAnomalies.Where(IsAnomalyConnectionVisible))
            {
                var color = ColorService.GetAnalysisColor(analysis);

                string targetY = analysis.Category switch
                {
                    AnalysisCategory.Anomaly => $"{AnomalyYPercent}%",
                    AnalysisCategory.Warning => $"{AnomalyYPercent + 5}%",
                    AnalysisCategory.Information => $"{AnomalyYPercent + 11}%",
                    _ => $"{AnomalyYPercent}%"
                };

                foreach (var point in GetAnomalyTargetPoints(analysis))
                {
                    var anx = analysis.Position + 10;
                    var poix = point.x + 6;

                    <line x1="@poix"
                          y1="@($"{point.yPercent}%")"
                          x2="@anx"
                          y2="@targetY"
                          stroke="@color"
                          stroke-width="@(0.7 + analysis.Severity)"
                          opacity="0.45"
                          stroke-linecap="round" />
                }
            }
            </svg>

        </div>

    </div>

    @if (ShowContextMenu)
    {
        var domain = ContextArtifact != null
            ? GetDomainOfArtifact(ContextArtifact)
            : null;

        <div class="context-menu"
             style="
            left:@($"{ContextMenuX}px");
            top:@($"{ContextMenuY}px");"
             @onclick:stopPropagation="true">

            @if (ContextArtifact != null)
            {
                <div class="context-item"
                     @onclick="OpenArtifactDetails">

                    📄 Mehr Details

                </div>

                @if (!string.IsNullOrWhiteSpace(domain))
                {
                    <div class="context-item"
                         @onclick="FilterByArtifactDomain">

                        🌐 Nach dieser Domäne filtern

                    </div>
                }

                <div class="context-item"
                     @onclick="ShowNavigationPathFilter">

                    🧭 Navigationsverlauf filtern

                </div>
            }

            @if (ContextArtifact is AnalysisEntry)
            {
                <div class="context-item" @onclick="FilterByAnalysisCategory">
                    🔍 Nach Analysekategorie filtern
                </div>
            }

            @if (NavigationFilterActive)
            {
                <div class="context-item"
                     @onclick="ClearNavigationFilter">

                    ❌ Navigationspfad-Filter aufheben

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(SelectedDomainFilter))
            {
                <div class="context-item"
                     @onclick="ClearDomainFilter">

                    ❌ Domain Filter aufheben

                </div>
            }

            @if (NavigationFilterActive && !string.IsNullOrWhiteSpace(SelectedDomainFilter))
            {
                <div class="context-item"
                     @onclick="ClearAllFilters">

                    ❌ Alle Filter aufheben

                </div>
            }

        </div>
    }
</div>

<div class="ui-overlay-root">

    @if (selectedExtension != null)
    {
        <ExtensionDetails Data="selectedExtension"
                          Anomalies="AnalysisEntries"
                          OnFocusAnomaly="FocusAnomaly"
                          OnClose="CloseAll" />
    }
    else if (selectedCookie != null)
    {
        <CookieDetails Data="selectedCookie"
                       Anomalies="AnalysisEntries"
                       OnFocusAnomaly="FocusAnomaly"
                       OnClose="CloseAll" />
    }
    else if (selectedInput != null)
    {
        <AutofillDetails Data="selectedInput"
                          AnalysisEntries="AnalysisEntries"
                          OnFocusAnomaly="FocusAnomaly"
                          OnClose="CloseAll" />
    }
    else if (selectedSubEntry != null)
    {
        <SubEntryDetails Data="selectedSubEntry"
                         Anomalies="AnalysisEntries"
                         OnFocusAnomaly="FocusAnomaly"
                         OnClose="CloseAll" />
    }
    else if (selectedDomain != null)
    {
        <DomainDetails Data="selectedDomain"
                       Anomalies="AnalysisEntries"
                       OnFocusAnomaly="FocusAnomaly"
                       OnClose="CloseAll" />
    }
    else if (selectedStorage != null)
    {
        <StorageDetails Data="selectedStorage"
                        Anomalies="AnalysisEntries"
                        OnFocusAnomaly="FocusAnomaly"
                        OnClose="CloseAll" />
    }
    else if (selectedAnalysis != null)
    {
        <AnomalyDetails Data="selectedAnalysis"
                        OnClose="CloseAll" />
    }

</div>