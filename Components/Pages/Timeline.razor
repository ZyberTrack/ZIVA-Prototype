                     data-findings="@GetTopFindings(ext)"
                     data-time="@ext.InstallTime"
                     @onclick="() => SelectExtension(ext)">
                </div>
            }
        }

        <!-- STORAGE Einträge in der Zeitachse -->
        @foreach (var s in State.StorageEntries)
        {
            if (s.Position > -50 && s.Position < viewportWidth - 300)
            {
                <div class="storage-marker @(s.IsSensitive ? "sensitive" : "")"
                     style="left: calc(@($"{s.Position}px - 5px"))"
                     data-key="@s.Key"
                     data-origin="@s.Origin"
                     data-value="@s.Value"
                     @onclick="() => SelectStorage(s)">
                </div>
            }
        }



        @if (selectedExtension != null)
        {
            <ExtensionDetails Data="selectedExtension" OnClose="CloseAll" />
        }
        else if (selectedCookie != null)
        {
            <CookieDetails Data="selectedCookie" OnClose="CloseAll" />
        }
        else if (selectedInput != null)
        {
            <AutofillDetails Data="selectedInput" OnClose="CloseAll" />
        }
        else if (selectedSubEntry != null)
        {
            <SubEntryDetails Data="selectedSubEntry" OnClose="CloseAll" />
        }
        else if (selectedDomain != null)
        {
            <DomainDetails Data="selectedDomain" OnClose="CloseAll" />
        }
        else if (selectedStorage != null)
        {
            <StorageDetails Data="selectedStorage" OnClose="CloseAll" />
        }

        



            <!-- SVG-Sammelcontainer für alle Linien -->
            <svg style="position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; z-index:18;">

                @foreach (var artifact in State.BrowserCookies.Cast<object>()
                                .Concat(State.AutofillEntries))
                {

                    string? artifactDomain = artifact switch
                    {
                        BrowserCookieEntry c =>
                        !string.IsNullOrWhiteSpace(c.Host) ? c.Host.TrimStart('.') :
                        !string.IsNullOrWhiteSpace(c.Name) ? c.Name.TrimStart('.') : null,
                        WebDataAutofillEntry a => a.Name.TrimStart('.'),
                        _ => null
                    };

                    if (string.IsNullOrEmpty(artifactDomain))
                        continue;


                    DateTime artifactTime = artifact switch
                    {
                        BrowserCookieEntry c => c.Created,
                        WebDataAutofillEntry a => a.DateCreated,
                        _ => DateTime.MinValue
                    };

                    double artifactPosX = artifact switch
                    {
                        BrowserCookieEntry c => c.Position - 2 ,
                        WebDataAutofillEntry a => a.Position - 2,
                        _ => 0
                    };

                    // DomainEntry matching nach Zeit (max 10s) & Domain/Name enthalten
                    DomainEntry? matchingDomain = SummarizedEntries
                    .Where(d =>
                    {
                        var domainNormalized = d.Domain.TrimStart('.').ToLower();
                        var artifactNormalized = artifact switch
                        {
                            BrowserCookieEntry c => !string.IsNullOrWhiteSpace(c.Host) ? c.Host.TrimStart('.').ToLower() :
                                        !string.IsNullOrWhiteSpace(c.Name) ? c.Name.TrimStart('.').ToLower() : "",
                            WebDataAutofillEntry a => a.Name.TrimStart('.').ToLower(),
                            _ => ""
                        };

                        return !string.IsNullOrEmpty(artifactNormalized) &&
                                    (domainNormalized.EndsWith(artifactNormalized) || artifactNormalized.EndsWith(domainNormalized));
                    })
                    .OrderBy(d => Math.Abs((artifactTime - d.VisitTime).TotalSeconds))
                    .FirstOrDefault(d => Math.Abs((artifactTime - d.VisitTime).TotalSeconds) <= 10);



                    if (matchingDomain == null)
                        continue;


                    @if (matchingDomain != null)
                    {
                        var matchingSub = matchingDomain.SubEntries?
                        .Where(s => artifactDomain.Contains(s.Url))
                        .OrderBy(s => Math.Abs((artifactTime - s.VisitTime).TotalSeconds))
                        .FirstOrDefault();

                        double domainPosX = matchingSub?.Position ?? matchingDomain.Position;

                        double domainPosY;

                        double offsetPx = 25 + heavyClusterSpacingPx * (matchingDomain.HeavyClusterIndex - 1);
                        double offsetPercent = (offsetPx / containerHeight) * 100.0;


                        if (matchingDomain.IsHeavyCluster)
                        {
                            domainPosY = baseTop - offsetPercent;
                            domainPosY = Math.Round(domainPosY);

                        }
                        else
                        {
                            // Normale Domain oder SubEntry
                            domainPosY = baseTop;
                        }

                        double artifactPosY = artifact switch
                        {
                            BrowserCookieEntry => 43,   // Cookies oben
                            WebDataAutofillEntry => 50, // Autofill etwas darunter
                            _ => 33
                        };

                        string color = GetColorForDomain(matchingDomain.Url);

                        <line x1="@domainPosX"
                              y1="@($"{domainPosY}%")"
                              x2="@artifactPosX"
                              y2="@($"{artifactPosY}%")"
                              stroke="@color"
                              stroke-width="2" />
                    }
                }

            </svg>

        <!-- 🔌 EXTENSION → WEB STORE VERBINDUNGEN -->
        <svg style="position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; z-index:18;">

            @foreach (var ext in State.Extensions)
            {
                // 1️⃣ WebStore Visit finden (bleibt zeitbasiert → ok)
                var matchingHistory = State.BrowserEntries
                    .Where(h =>
                        (h.Url.Contains("chrome.google.com/webstore") ||
                         h.Url.Contains("chromewebstore.google.com")) &&
                        Math.Abs((h.VisitTime - ext.InstallTime).TotalMinutes) <= 10
                    )
                    .OrderBy(h => Math.Abs((h.VisitTime - ext.InstallTime).TotalSeconds))
                    .FirstOrDefault();

                if (matchingHistory == null)
                    continue;

                // 2️⃣ 🔥 DomainEntry sauber über SubEntries matchen (KEIN Zeit-Hack mehr)
                var matchingDomain = SummarizedEntries
                    .FirstOrDefault(d =>
                        d.SubEntries.Any(s => s.Url == matchingHistory.Url)
                    );

                // 🔁 Fallback (falls kein exakter Match)
                if (matchingDomain == null)
                {
                    var host = new Uri(matchingHistory.Url).Host;

                    matchingDomain = SummarizedEntries
                        .FirstOrDefault(d =>
                            host.Contains(d.Domain) || d.Domain.Contains(host)
                        );
                }

                if (matchingDomain == null)
                    continue;

                // 3️⃣ Domain Position
                double domainPosX = matchingDomain.Position;

                double domainPosY;
                double offsetPx = 25 + heavyClusterSpacingPx * (matchingDomain.HeavyClusterIndex - 1);
                double offsetPercent = (offsetPx / containerHeight) * 100.0;

                if (matchingDomain.IsHeavyCluster)
                {
                    domainPosY = baseTop - offsetPercent;
                    domainPosY = Math.Round(domainPosY);
                }
                else
                {
                    domainPosY = baseTop;
                }

                // 4️⃣ Extension Position
                double extensionPosX = ext.Position;
                double extensionPosY = 64;

                // 5️⃣ Farbe
                string color = GetColorForDomain(matchingDomain.Url);

                // 6️⃣ Linie
                <line x1="@domainPosX"
                      y1="@($"{domainPosY}%")"
                      x2="@extensionPosX"
                      y2="@($"{extensionPosY}%")"
                      stroke="@color"
                      stroke-width="2"
                      stroke-dasharray="4,3"
                      opacity="0.8" />
            }

        </svg>



            <!-- ANOMALIE ZEITACHSE -->
            @code {

                int baseTop = 33; // Basislinie für normale Domains in %
                int heavyClusterSpacingPx = 20; // Abstand jeder neuen Heavy Cluster-Linie nach oben

                string GetSeverityColor(int severity) => severity switch
                {
                    5 => "#ff2d2d",   // Rot – kritisch
                    4 => "#ff6b00",   // Dunkelorange
                    3 => "#ffb000",   // Orange
                    2 => "#3fa9f5",   // Blau
                    _ => "#9e9e9e"    // Grau
                };

				// Y-Position der Domain in Prozent
                double GetDomainYPercent(DomainEntry domain)
                {
                    if (!domain.IsHeavyCluster)
                        return baseTop;

                    double offsetPx = 25 + heavyClusterSpacingPx * (domain.HeavyClusterIndex - 1);
                    double offsetPercent = (offsetPx / containerHeight) * 100.0;

                    return Math.Round(baseTop - offsetPercent);
                }

				// Y-Position der Anomalie in Pixel
                double AnomalyYPercent => 78;


                IEnumerable<(double x, double yPercent)> GetAnomalyTargetPoints(DomainEntry domain)
                {
                    double y = GetDomainYPercent(domain);

                    if (domain.IsHeavyCluster || domain.IsExpanded)
                    {
                        foreach (var sub in domain.SubEntries)
                            yield return (sub.Position, y);
                        yield break;
                    }

                    yield return (domain.Position, y);
                }

				// Hilfsmethode: Zielpunkt der Anomalie ermitteln (z.B. Cookie oder Autofill)
                (double x, double yPercent)? GetAnomalyTargetPoint(AnomalyEntry anomaly)
                {
                    switch (anomaly.Type)
                    {
                        case AnomalyType.DeletedHistoryIndicator:
                            {
                                // Cookie?
                                var cookie = State.BrowserCookies?
                                .FirstOrDefault(c =>
                                Math.Abs((c.Created - anomaly.FirstSeen).TotalSeconds) <= 1);

                                if (cookie != null)
                                    return (cookie.Position, 43); // Cookie-Linie

                                // Autofill?
                                var autofill = State.AutofillEntries?
                                .FirstOrDefault(a =>
                                Math.Abs((a.DateCreated - anomaly.FirstSeen).TotalSeconds) <= 1);

                                if (autofill != null)
                                    return (autofill.Position, 50); // Autofill-Linie

                                return null;
                            }

                        default:
                            return null;
                    }
                }


            }

            @foreach (var anomaly in Anomalies)
            {
                var color = GetSeverityColor(anomaly.Severity);

                <div class="anomaly-marker"
                     style="position:absolute;
                    left:@($"{anomaly.Position - 6}px");
                    top:@($"{AnomalyYPercent}%");
                    transform: translateY(-50%);
                    color:@color;
                    z-index:30;"
                     data-time="@anomaly.FirstSeen"
                     data-lastseen="@anomaly.LastSeen"
                     data-url="@anomaly.Url"
                     data-type="@anomaly.Type"
                     data-description="@anomaly.Description"
                     data-severity="@anomaly.Severity"
                     data-count="@anomaly.Count">

                    <!-- 🔺 Gefülltes Dreieck -->
                    <svg width="16" height="50" viewBox="0 0 16 50">
                        <polygon points="0,0 16,0 8,50" fill="currentColor" />
                    </svg>

                </div>
            }


            <svg style="position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; z-index:15;">
                @foreach (var anomaly in Anomalies)
                {
                    var color = GetSeverityColor(anomaly.Severity);

                    // 🧨 Deleted-History → Artefakt
                    if (anomaly.Type == AnomalyType.DeletedHistoryIndicator)
                    {
                        var target = GetAnomalyTargetPoint(anomaly);
                        if (target == null) continue;

                        <line x1="@target.Value.x"
                              y1="@($"{target.Value.yPercent}%")"
                              x2="@anomaly.Position"
                              y2="@($"{AnomalyYPercent}%")"
                              stroke="@color"
                              stroke-width="@(0.7 + anomaly.Severity)"
                              stroke-dasharray="4,3" />
                    }
                    // 🔴 Domain-basierte Anomalien
                    else
                    {
                        var domain = anomaly.LinkedDomain;
                        if (domain == null) continue;

                        foreach (var point in GetAnomalyTargetPoints(domain))
                        {
                            <line x1="@point.x"
                                  y1="@($"{point.yPercent}%")"
                                  x2="@anomaly.Position"
                                  y2="@($"{AnomalyYPercent}%")"
                                  stroke="@color"
                                  stroke-width="@(0.7 + anomaly.Severity)"
                                  stroke-dasharray="4,3" />
                        }
                    }
                }
            </svg>


        </div>
    </div>
</div>
