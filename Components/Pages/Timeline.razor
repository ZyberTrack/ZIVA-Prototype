            ext.Findings
               .OrderByDescending(f => f.Weight)
               .Take(2)
               .Select(f => f.Description));
    }

    //------------------------------------------------------------
    // Initial Render
    //------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        await UpdateViewportSizeAsync();

        await LoadAnomalyListsAsync();

        State.OnChange += Refresh;

        // Nur State laden – KEIN direktes DB-Laden mehr!
        await PersistService.LoadPersistedStateAsync(State);

    }

    private void Refresh()
    {
        if (State.BrowserEntries.Any())
        {
            SummarizedEntries = SummarizeEntries(
                State.BrowserEntries,
                zoomLevels[currentZoomIndex].seconds
            );
        }

        var aggregator = new UserInputAggregatorService();

        UserInputs = aggregator.Build(
            State.BrowserEntries,
            State.AutofillEntries
        );

        RecalculatePositions();
        RecalculateCookiePositions();
        RecalculateUserInputPositions();
        RecalculateSummarizedPositions();
        RecalculateExtensionPositions();
        DetectAnomalies();
        RecalculateAnomalyPositions();
        RecalculateStoragePositions();
        UpdateVisibleTimestamps();

        InvokeAsync(StateHasChanged);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerResizeHandler", selfRef);
            await JS.InvokeVoidAsync("timelineInterop.registerScrollHandler", selfRef, scrollDivRef);
            await JS.InvokeVoidAsync("registerDragHandler", selfRef);
            await JS.InvokeVoidAsync("registerZoomHandler", selfRef);
            await JS.InvokeVoidAsync("registerArrowKeys", selfRef);
        }
    }


