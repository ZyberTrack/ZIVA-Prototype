    //------------------------------------------------------------
    // FILTER
    //------------------------------------------------------------

    private async Task ApplyDomainFilter()
    {
        if (_applyingFilter)
            return;

        _applyingFilter = true;

        var visibleAnalysis = AnalysisEntries.AsEnumerable();

        if (AnalysisFilterActive)
        {
            visibleAnalysis = visibleAnalysis.Where(a =>
                   (ShowInformation && a.Category == AnalysisCategory.Information)
                || (ShowWarnings && a.Category == AnalysisCategory.Warning)
                || (ShowAnomalies && a.Category == AnalysisCategory.Anomaly));
        }

        var analysisList = visibleAnalysis.ToList();

        try
        {
            RenderCache.BuildVisibleCaches(
                State.BrowserEntries,
                State.BrowserCookies,
                UserInputs,
                State.Extensions,
                State.StorageEntries,
                DomainEntries,
                analysisList,

                AnalysisFilterActive,

                ArtifactFilterActive,
                ShowHistory,
                ShowCookies,
                ShowInputs,
                ShowExtensions,
                ShowStorage,

                viewportWidth,
                SelectedDomainFilter);

            RecalculatePositions(
                State.BrowserEntries,
                x => x.VisitTime,
                (x, pos) => x.Position = pos);

            RecalculatePositions(
                State.BrowserCookies,
                x => x.Created,
                (x, pos) => x.Position = pos);

            RecalculatePositions(
                UserInputs,
                x => x.Time,
                (x, pos) => x.Position = pos);

            RecalculatePositions(
                State.Extensions,
                x => x.InstallTime,
                (x, pos) => x.Position = pos);

            RecalculatePositions(
                State.StorageEntries,
                x => x.Time,
                (x, pos) => x.Position = pos);

            RecalculatePositions(
                DomainEntries,
                x => x.VisitTime,
                (x, pos) => x.Position = pos);

            RecalculateAnomalyPositions();

            FilteredAnalysisEntries = RenderCache.VisibleAnomalies;

            BuildArtifactTimeline(RenderCache.VisibleAnomalies);

            // Nur einmal automatisch fokussieren,
            // solange sich der Filter nicht geändert hat.
            if (!string.IsNullOrWhiteSpace(SelectedDomainFilter) &&
                _lastAutoFocusedFilter != SelectedDomainFilter)
            {
                _lastAutoFocusedFilter = SelectedDomainFilter;

                var firstArtifact = TimelineArtifacts.FirstOrDefault(a =>
                    a.Data is BrowserHistoryEntry h &&
                    h.Url.Contains(SelectedDomainFilter,
                        StringComparison.OrdinalIgnoreCase));

                if (firstArtifact != null)
                {
                    await FocusArtifact(firstArtifact);
                }
            }

            //------------------------------------------------------
            // NAVIGATION PATH FILTER
            //------------------------------------------------------

            if (IncludeNavigationPaths)
            {
                var histories = RenderCache.VisibleHistory.ToList();

                foreach (var history in histories)
                {
                    var path =
                        NavigationService.BuildNavigationPath(
                            history,
                            DomainEntries,
                            State.BrowserCookies,
                            UserInputs,
                            State.Extensions,
                            State.StorageEntries,
                            AnalysisEntries);

                    RenderCache.AddNavigationPath(path);
                }
            }
            else if (ShowNavigationPath && NavigationRootArtifact != null)
            {
                CurrentNavigationPath =
                    NavigationService.BuildNavigationPath(
                        NavigationRootArtifact,
                        DomainEntries,
                        State.BrowserCookies,
                        UserInputs,
                        State.Extensions,
                        State.StorageEntries,
                        AnalysisEntries);

                RenderCache.ApplyNavigationPath(CurrentNavigationPath);
            }

            StateHasChanged();
        }
        finally
        {
            _applyingFilter = false;
        }
    }

