    private string? GetDomainOfArtifact(object artifact)
    {
        return artifact switch
        {
            DomainEntry d => d.Domain,

            BrowserHistoryEntry h =>
                DomainEntries
                    .FirstOrDefault(d => d.SubEntries.Contains(h))
                    ?.Domain,

            BrowserCookieEntry c =>
                c.Relations.FirstOrDefault()?.Domain?.Domain,

            UserInputEntry i =>
                i.Relations.FirstOrDefault()?.Domain?.Domain,

            BrowserExtensionEntry e =>
                e.Relations.FirstOrDefault()?.Domain?.Domain,

            StorageEntry s =>
                s.Relations.FirstOrDefault()?.Domain?.Domain,

            _ => null
        };
    }

    private async Task FilterByAnalysisCategory()
    {
        if (ContextArtifact is not AnalysisEntry analysis)
            return;

        // Alle Filter zurücksetzen
        ShowInformation = false;
        ShowWarnings = false;
        ShowAnomalies = false;

        // Gewünschte Kategorie aktivieren
        switch (analysis.Category)
        {
            case AnalysisCategory.Information:
                ShowInformation = true;
                break;

            case AnalysisCategory.Warning:
                ShowWarnings = true;
                break;

            case AnalysisCategory.Anomaly:
                ShowAnomalies = true;
                break;
        }

        ShowContextMenu = false;

        await ApplyDomainFilter();
    }

