@page "/"
@inject IJSRuntime JS
@implements IDisposable
@using ZIVA_Prototype.Components.Models
@inject TimelineStateService State // Verwaltet States mehrerer Importierter Datenbanken
@inject HistoryImportService Importer

@code {


    //
    // TIMELINE ARTEFAKTE WERDEN POSITIONSMÄSSIG FALSCH ANGEZEIGT!!!
    //

    private bool isZooming = false; // Flag to indicate if zooming is in progress
    private BrowserHistoryEntry? selectedEntry; // Aktuell ausgewählte Browser Artefakt Entry


    [JSInvokable("OnScrollPositionChanged")]
    public Task OnScrollPositionChanged(int scrollLeft)
    {
        // Berechne neuen scrollIndex basierend auf scrollLeft
        scrollIndex = (int)Math.Round((scrollLeft - startOffset) / (double)spacing);
        UpdateVisibleEntries();
        StateHasChanged();
        return Task.CompletedTask;
    }


    private int viewportWidth;
    private int startOffset = 70;
    private int spacing = 250;
    private int visibleTimestamps = 0;
    private int scrollIndex = 0;
    private int renderBuffer = 5;
    private int lastScrollIndex = int.MinValue;
    private int movableLayerWidth = 0;
    private DateTime baseTime = DateTime.Now; // Später durch Importdaten ersetzbar

    // Intelligent Zoom
    private readonly int[] zoomLevelsInSeconds = new[]
    {
    10,      // 10 Sekunden
    30,      // 30 Sekunden
    60,      // 1 Minute
    300,     // 5 Minuten
    600,     // 10 Minuten
    1200,    // 20 Minuten
    1800,    // 30 Minuten
    3600,    // 1 Stunde
    7200,    // 2 Stunden
    86400,   // 24 Stunden (1 Tag)
    172800,  // 48 Stunden (2 Tage)
    259200,  // 72 Stunden (3 Tage)
    604800,  // 1 Woche (7 Tage)
    1209600, // 2 Wochen (14 Tage)
    2419200, // 1 Monat (30 Tage)
    5184000, // 2 Monate (60 Tage)
    7776000, // 3 Monate (90 Tage)
    10368000,// 4 Monate (120 Tage)
    15552000,// 6 Monate (180 Tage)
    31104000,// 1 Jahr (365 Tage)
    63072000,// 2 Jahre
    };

    private int currentZoomIndex = 3; // Start bei 10 Minuten (600 Sekunden)
    private int CurrentIntervalInSeconds => zoomLevelsInSeconds[currentZoomIndex];
    private double PixelsPerSecond => viewportWidth / (double)CurrentIntervalInSeconds; //Anzeige Intervall in Pixel pro Sekunden für Timeline Einträge
    private DateTime currentViewportStartTime => baseTime.AddSeconds(scrollIndex * CurrentIntervalInSeconds); //Zugriff basierend auf dem aktuellen Zoomlevel, aktuellen Scrollindex den Startzeitpunkt der Ansicht berechnet.




    private DotNetObjectReference<Timeline>? selfRef;

    private List<TimestampEntry> visibleEntries = new();

    public class TimestampEntry
    {
        public int Index { get; set; }
        public DateTime Time { get; set; }
        public int Position { get; set; }
    }

    private async Task LoadFromDatabase()
    {
        var filePath = Path.Combine(FileSystem.AppDataDirectory, "history.sqlite");

        // Beispiel: sicherstellen, dass die Datei existiert
        if (File.Exists(filePath))
        {
            var entries = Importer.LoadFromHistoryDatabase(filePath);
            State.SetBrowserEntries(entries);
        }
        else
        {
            Console.WriteLine("Datei nicht gefunden: " + filePath);
        }

        // Debugging
        await JS.InvokeVoidAsync("alert", $"Importiert: {State.BrowserEntries.Count} Einträge");
        await JS.InvokeVoidAsync("alert", $"Erste URL: {State.BrowserEntries.FirstOrDefault()?.Url}");


        await Task.CompletedTask; // um async-Konformität zu behalten
    }


    protected override async Task OnInitializedAsync()
    {
        await UpdateViewportWidthAsync();
        await LoadFromDatabase();

        // Basiszeitpunkt auf frühesten Besuchszeitpunkt setzen
        if (State.BrowserEntries.Any())
        {
            baseTime = State.BrowserEntries.Min(e => e.VisitTime);
        }

        UpdateVisibleEntries();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerResizeHandler", selfRef);
            await JS.InvokeVoidAsync("timelineInterop.registerScrollHandler", selfRef);
            await JS.InvokeVoidAsync("registerDragHandler", selfRef);
            await JS.InvokeVoidAsync("registerZoomHandler", selfRef);
        }
    }

    [JSInvokable("OnResize")] // Elemente werden Visuell dem Fenster angepasst
    public async Task OnResizeAsync()
    {
        await UpdateViewportWidthAsync();
        UpdateVisibleEntries();
        StateHasChanged();
    }

    private async Task UpdateViewportWidthAsync()
    {
        viewportWidth = Math.Max(await JS.InvokeAsync<int>("getViewportWidth"), 300); // Minimum
        visibleTimestamps = Math.Max(0, (viewportWidth - startOffset));
    }

    private void UpdateVisibleEntries()
    {
        // Berechnung des Start- und Endbereichs der sichtbaren Einträge
        int renderStart = scrollIndex - renderBuffer;
        int renderEnd = scrollIndex + visibleTimestamps + renderBuffer;

        int currentMin = visibleEntries.Count > 0 ? visibleEntries.Min(e => e.Index) : int.MaxValue;
        int currentMax = visibleEntries.Count > 0 ? visibleEntries.Max(e => e.Index) : int.MinValue;

        // Wenn noch keine sichtbaren Einträge vorhanden sind, Initialisierung mit der Standardanzahl an Einträgen
        if (visibleEntries.Count == 0)
        {
            // Initialisiere mit einer Anzahl von Einträgen, die den gesamten sichtbaren Bereich abdecken
            for (int i = renderStart; i < renderEnd; i++)
            {
                visibleEntries.Add(CreateEntry(i));
            }
        }
        else
        {
            // Füge neue Einträge nach links hinzu, falls nötig
            if (renderStart < currentMin)
            {
                for (int i = renderStart; i < currentMin; i++)
                {
                    visibleEntries.Insert(0, CreateEntry(i));
                }
            }

            // Füge neue Einträge nach rechts hinzu, falls nötig
            if (renderEnd > currentMax)
            {
                for (int i = currentMax + 1; i <= renderEnd; i++)
                {
                    visibleEntries.Add(CreateEntry(i));
                }
            }
        }

        // Neue Breite des scrollbaren Layers berechnen
        int entryCount = renderEnd - renderStart + 1;
        movableLayerWidth = entryCount * spacing + startOffset;

        RecalculatePositions();
        lastScrollIndex = scrollIndex;


        // Entferne Einträge links außerhalb des sichtbaren Bereichs
        visibleEntries.RemoveAll(e => e.Index < renderStart);

        // Entferne Einträge rechts außerhalb des sichtbaren Bereichs
        visibleEntries.RemoveAll(e => e.Index > renderEnd);
    }



    private TimestampEntry CreateEntry(int index)
    {
        return new TimestampEntry
            {
                Index = index,
                Time = baseTime.AddSeconds(index * CurrentIntervalInSeconds), // kann auch negativ sein - intervall in Sekunden
                Position = 0
            };
    }

    private void RecalculatePositions()
    {
        foreach (var entry in visibleEntries)
        {
            entry.Position = startOffset + (entry.Index - scrollIndex) * spacing;
        }
    }

    [JSInvokable("OnScroll")]
    public Task OnScrollAsync(string direction)
    {
        if (direction == "right")
            scrollIndex += (int)(viewportWidth / spacing / 10);
        else if (direction == "left")
            scrollIndex -= (int)(viewportWidth / spacing / 10);

        UpdateVisibleEntries();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable("OnZoom")]
    public async Task OnZoomAsync(string direction)
    {
        isZooming = true; // Flag setzen, um anzuzeigen, dass ein Zoom-Vorgang stattfindet

        if (direction == "in" && currentZoomIndex > 0)
            currentZoomIndex--;
        else if (direction == "out" && currentZoomIndex < zoomLevelsInSeconds.Length - 1)
            currentZoomIndex++;


        // Sichtbare Einträge neu berechnen
        visibleEntries.Clear();
        UpdateVisibleEntries();
        StateHasChanged();

        // Optional kleine Pause, damit JS keine Scrolls mehr sendet
        await Task.Delay(50); // 50 ms genügt meist

        isZooming = false; // Flag zurücksetzen, wenn der Zoom-Vorgang abgeschlossen ist
    }


    public void Dispose()
    {
        selfRef?.Dispose();
    }
}

<!-- RAZOR MARKUP -->
<div class="timeline-wrapper">
    <div class="legend-area">
        <div class="timeline-area-static timeline-area-top">
            <div class="timeline-label">Verlauf-Zeitachse</div>
            <div class="timeline"></div>
        </div>
        <div class="timeline-area-static timeline-area-bottom">
            <div class="timeline-label">Analyse-Zeitachse</div>
            <div class="timeline"></div>
        </div>
    </div>

    <div class="timeline-static">
        <div class="timeline-area-scroll timeline-area-top">
            <div class="timeline"></div>
        </div>

        <div class="timeline-area-scroll timeline-area-bottom">
            <div class="timeline"></div>
        </div>
    </div>

    <div class="timeless-area">
        <div class="timeline-area-static">
            <div class="timeline-label">Zeitstempel Unbekannt</div>
            <div class="timeline"></div>
        </div>
        <div class="timeline-area-static">
            <div class="timeline"></div>
        </div>
    </div>


    <div class="timeline-container">
        <!-- Externer Container mit fixer Breite & overflow -->
        <div id="scroll-container" class="scroll-wrapper scroll-wrapper-timeline">
            <div class="movable-layer" style="width:@(movableLayerWidth)px; position: relative;">
                @foreach (var entry in visibleEntries)
                {
                    <div @key="entry.Index" class="timestamp" style="left:@($"{entry.Position}px")">
                        <span>
                            @entry.Time.ToString(
                                     CurrentIntervalInSeconds < 60 ? "yyyy-MM-dd HH:mm:ss" :      // Sekunden bis Minuten
                                     CurrentIntervalInSeconds < 3600 ? "yyyy-MM-dd HH:mm" :        // Minuten bis Stunden
                                     CurrentIntervalInSeconds < 86400 ? "yyyy-MM-dd HH:mm" :       // Stunden bis 24 Stunden
                                     CurrentIntervalInSeconds < 2592000 ? "yyyy-MM-dd" :            // Ab 30 Tagen auf "yyyy-MM-dd"
                                     CurrentIntervalInSeconds < 31536000 ? "yyyy-MM" :               // Ab 2 Monaten auf "yyyy-MM"
                                     "yyyy"                                                       // Ab 1 Jahr auf "yyyy-MM"
                                     )
                        </span>
                    </div>
                    <div class="line" style="left:@($"{entry.Position}px")"></div>
                }




                @foreach (var data in State.BrowserEntries)
                {
                    var timeOffsetSeconds = (data.VisitTime - currentViewportStartTime).TotalSeconds; // Sekunden seit dem Render Startzeitpunkt
                    var pos = startOffset + timeOffsetSeconds * PixelsPerSecond;

                    
                    <!-- Debugging Informationen -->
                    <div style="margin-left: 260px; background-color: white;">
                        <pre>
                            Pos: @pos
                                SecondsSinceBase: @timeOffsetSeconds
                            VisitTime: @data.VisitTime
                        </pre>
                    </div>



                    if (pos > -50 && pos < viewportWidth + 50) // Sichtbarkeit prüfen
                    {
                        <div class="history-marker"
                             style="left: calc(@($"{pos}px - 5px"))"
                             data-url="@data.Url"
                             @onclick="() => selectedEntry = data">
                        </div>
                    }
                }
                @if (selectedEntry != null)
                {
                    <div class="entry-details">
                        <p><strong>Besuchszeit:</strong> @selectedEntry.VisitTime</p>
                        <p><strong>URL:</strong> @selectedEntry.Url</p>
                        @if (!string.IsNullOrEmpty(selectedEntry.Title))
                        {
                            <p><strong>Titel:</strong> @selectedEntry.Title</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
