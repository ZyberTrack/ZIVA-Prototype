                            </div>
                        }

                    }
                </div>
            }

            <!-- Cookies Einträge in der Zeitachse -->
            @foreach (var cookie in RenderCache.VisibleCookies)
            {
                <div class="cookie-marker"
                     style="
                    left: calc(@($"{cookie.Position}px - 5px"));
                    --marker-color:@ColorService.GetCookieColor(cookie.Category);
                    color:@ColorService.GetCookieColor(cookie.Category);
                    @GetFocusedStyle(cookie)"
                         data-host="@cookie.Host"
                         data-valueEncr="@cookie.EncryptedValue"
                         data-value="@cookie.Value"
                         data-time="@cookie.Created"
                         @onclick="() => SelectCookie(cookie)">
                    </div>
            }



            <!-- User Input Einträge in der Zeitachse -->
            @foreach (var item in RenderCache.VisibleInputs)
        {
                string cssClass = item.Type switch
                {
                    UserInputType.SearchQuery => "search",
                    UserInputType.Autofill => "autofill",
                    UserInputType.Favicon => "favicon",
                    _ => ""
                };

                <div class="userinput-marker @cssClass"
                     style="left: calc(@($"{item.Position}px - 5px"));
                    @GetFocusedStyle(item)"
                     data-value="@item.Value"
                     data-time="@item.Time"
                     data-type="@item.Type"
                     @onclick="() => SelectInput(item)">
                </div>
        }


        <!-- Extensions in der Zeitachse -->
            @foreach (var ext in RenderCache.VisibleExtensions)
        {
                <div class="extension-marker"
                     style="left: calc(@($"{ext.Position}px - 5px"));
                    @GetFocusedStyle(ext)"
                     data-name="@ext.Name"
                     data-risk="@ext.RiskLevel"
                     data-score="@ext.RiskScore"
                     data-findings="@GetTopFindings(ext)"
                     data-time="@ext.InstallTime"
                     @onclick="() => SelectExtension(ext)">
                </div>
        }

        <!-- STORAGE Einträge in der Zeitachse -->
            @foreach (var s in RenderCache.VisibleStorage)
        {
                <div class="storage-marker @(s.IsSensitive ? "sensitive" : "")"
                     style="left: calc(@($"{s.Position}px - 5px"));
                    @GetFocusedStyle(s)"
                     data-key="@s.Key"
                     data-origin="@s.Origin"
                     data-value="@s.Value"
                     @onclick="() => SelectStorage(s)">
                </div>
        }


            <!-- RELATION LINES -->
            <svg style="
                position:absolute;
                left:0;
                top:0;
                width:100%;
                height:100%;
                pointer-events:none;
                z-index:18;">

                @foreach (var cookie in RenderCache.VisibleCookies)
                {
                    foreach (var relation in cookie.Relations)
                    {
                        if (relation.Domain == null)
                            continue;

                        double domainPosX =
                            relation.Domain.Position;

                        double domainPosY =
                            GetDomainYPercent(
                                relation.Domain);

                        double cookiePosX =
                            cookie.Position - 2;

                        double cookiePosY = 43;

                        string color =
                            ColorService.GetColor(
                                relation.Domain.Url);

                        <line x1="@domainPosX"
                              y1="@($"{domainPosY}%")"
                              x2="@cookiePosX"
                              y2="@($"{cookiePosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }

                @foreach (var input in RenderCache.VisibleInputs)
                {
                    foreach (var relation in input.Relations)
                    {
                        if (relation.Domain == null)
                            continue;

                        double domainPosX =
                            relation.Domain.Position;

                        double domainPosY =
                            GetDomainYPercent(
                                relation.Domain);

                        double inputPosX =
                            input.Position - 2;

                        double inputPosY =
                            input.Type switch
                            {
                                UserInputType.Autofill => 50,
                                UserInputType.Favicon => 50,
                                _ => 50
                            };

                        string color =
                            ColorService.GetColor(
                                relation.Domain.Url);

                        <line x1="@domainPosX"
                              y1="@($"{domainPosY}%")"
                              x2="@inputPosX"
                              y2="@($"{inputPosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }

                @foreach (var ext in RenderCache.VisibleExtensions)
                {
                    foreach (var relation in ext.Relations)
                    {
                        if (relation.Type !=
                            ArtifactRelationType
                                .ExtensionToWebStore)
                            continue;

                        if (relation.Domain == null)
                            continue;

                        double domainPosX =
                            relation.Domain.Position;

                        double domainPosY =
                            GetDomainYPercent(
                                relation.Domain);

                        double extPosX =
                            ext.Position;

                        double extPosY = 64;

                        string color =
                            ColorService.GetColor(
                                relation.Domain.Url);

                        <line x1="@domainPosX"
                              y1="@($"{domainPosY}%")"
                              x2="@extPosX"
                              y2="@($"{extPosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }

                @foreach (var storage in RenderCache.VisibleStorage)
                {
                    foreach (var relation in storage.Relations)
                    {
                        if (relation.Domain == null)
                            continue;

                        double domainPosX =
                            relation.Domain.Position;

                        double domainPosY =
                            GetDomainYPercent(
                                relation.Domain);

                        double storagePosX =
                            storage.Position;

                        double storagePosY = 57;

                        string color =
                            ColorService.GetColor(
                                relation.Domain.Url);

                        <line x1="@domainPosX"
                              y1="@($"{domainPosY}%")"
                              x2="@storagePosX"
                              y2="@($"{storagePosY}%")"
                              stroke="@color"
                              stroke-width="2"
                              opacity="0.25"
                              stroke-linecap="round" />
                    }
                }

            </svg>

            @foreach (var anomaly in RenderCache.VisibleAnomalies)
            {
                var color = GetSeverityColor(anomaly.Severity);

                <div class="anomaly-marker"
                     style="position:absolute;
                    left:@($"{anomaly.Position - 6}px");
                    top:@($"{AnomalyYPercent}%");
                    transform: translateY(-50%);
                    color:@color;
                    z-index:30;"
                     data-time="@anomaly.FirstSeen"
                     data-lastseen="@anomaly.LastSeen"
                     data-url="@anomaly.Url"
                     data-type="@anomaly.Type"
                     data-description="@anomaly.Description"
                     data-severity="@anomaly.Severity"
                     data-count="@anomaly.Count"
                     @onclick="() => FocusAnomaly(anomaly)">


                    <div style="
                        width:@($"{10 + anomaly.Severity * 2}px");
                        height:@($"{10 + anomaly.Severity * 2}px");
                        border-radius:50%;
                        background:currentColor;
                        ">
                    </div>

                </div>
            }


            <svg style="position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; z-index:15;">

                @foreach (var anomaly in Anomalies.Where(IsAnomalyConnectionVisible))
                {
                    var color = GetSeverityColor(anomaly.Severity);

                    foreach (var point in GetAnomalyTargetPoints(anomaly))
                    {
                        <line x1="@point.x"
                              y1="@($"{point.yPercent}%")"
                              x2="@anomaly.Position"
                              y2="@($"{AnomalyYPercent}%")"
                              stroke="@color"
                              stroke-width="@(0.7 + anomaly.Severity)"
                              opacity="0.45"
                              stroke-linecap="round" />
                    }
                }

            </svg>

        </div>

    </div>
</div>

<div class="ui-overlay-root">

    @if (selectedExtension != null)
    {
        <ExtensionDetails Data="selectedExtension"
                          Anomalies="Anomalies"
                          OnFocusAnomaly="FocusAnomaly"
                          OnClose="CloseAll" />
    }
    else if (selectedCookie != null)
    {
        <CookieDetails Data="selectedCookie"
                       Anomalies="Anomalies"
                       OnFocusAnomaly="FocusAnomaly"
                       OnClose="CloseAll" />
    }
    else if (selectedInput != null)
    {
        <AutofillDetails Data="selectedInput"
                         Anomalies="Anomalies"
                         OnFocusAnomaly="FocusAnomaly"
                         OnClose="CloseAll" />
    }
    else if (selectedSubEntry != null)
    {
        <SubEntryDetails Data="selectedSubEntry"
                         Anomalies="Anomalies"
                         OnFocusAnomaly="FocusAnomaly"
                         OnClose="CloseAll" />
    }
    else if (selectedDomain != null)
    {
        <DomainDetails Data="selectedDomain"
                       Anomalies="Anomalies"
                       OnFocusAnomaly="FocusAnomaly"
                       OnClose="CloseAll" />
    }
    else if (selectedStorage != null)
    {
        <StorageDetails Data="selectedStorage"
                        Anomalies="Anomalies"
                        OnFocusAnomaly="FocusAnomaly"
                        OnClose="CloseAll" />
    }
    else if (selectedAnomaly != null)
    {
        <AnomalyDetails Data="selectedAnomaly"
                        OnClose="CloseAll" />
    }

</div>