                                <strong>@e.Name</strong><br />

                                @e.InstallTime <br />

                                px=@e.Position

                            </li>
                        }
                    </ul>
                </div>

                <div class="artifact-column">
                    <strong>Storage (@State.StorageEntries.Count)</strong>

                    <ul>
                        @foreach (var s in State.StorageEntries)
                        {
                            <li class="artifact-clickable artifact-anomaly"
                                style="@GetArtifactStyle(s)"
                                @onclick="() => SelectStorage(s)">

                                <strong>@s.Key</strong><br />

