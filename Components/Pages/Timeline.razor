    async Task FocusAnomaly(AnalysisEntry anomaly)
    {
        SyncFocusedArtifact(anomaly);

        if (focusedArtifact != null)
            visualFocusedArtifact = focusedArtifact;

        visualFocusedAnomalyId = anomaly.Id;

        DateTime focusTime;

        if (anomaly.FirstSeen == anomaly.LastSeen)
        {
            focusTime = anomaly.FirstSeen;
        }
        else
        {
            long ticks =
                (anomaly.FirstSeen.Ticks + anomaly.LastSeen.Ticks) / 2;

            focusTime = new DateTime(ticks);
        }

        await CenterOnTime(focusTime);

        Refresh();

        StateHasChanged();
    }

    bool IsFocused(object obj)
    {
        if (obj is AnalysisEntry anomaly)
            return visualFocusedAnomalyId == anomaly.Id;

        return visualFocusedArtifact?.Data == obj;
    }

