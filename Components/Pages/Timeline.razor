    private async Task UpdateViewportSizeAsync()
    {
        viewportWidth = Math.Max(await JS.InvokeAsync<int>("getViewportWidth"), 300);

        // Für SVG Rendering
        containerHeight = await JS.InvokeAsync<int>("getElementHeight", "scroll-container");

    }

    // Nur Zeitstempel betreffend
    private void UpdateVisibleTimestamps()
    {
        int centerIndex = (int)((scrollIndex - InitialOffsetPx) / spacing);
        int firstVisibleIndex = (int)((scrollIndex - InitialOffsetPx) / spacing) - renderBuffer;
        int lastVisibleIndex = firstVisibleIndex + (int)(viewportWidth / spacing) + 2 * renderBuffer;


        visibleEntries = new();
        for (int i = firstVisibleIndex; i <= lastVisibleIndex; i++)
        {
            var entry = CreateEntry(i);
            entry.Position = InitialOffsetPx + i * spacing;            // direktes Positionieren, scrollBar sorgt für Bewegung
            visibleEntries.Add(entry);
        }

        //NEU: width so setzen, dass auch negative Einträge Platz haben
        int minIndex = firstVisibleIndex;
        int maxIndex = lastVisibleIndex;

        //Optional: baseOffset setzen, um negative Indexe sichtbar zu machen
        startOffset = -minIndex * spacing + 250; // z. B. 250px Puffer nach links
    }

    private void RecalculatePositions<T>(
    IEnumerable<T> items,
    Func<T, DateTime> getTime,
    Action<T, int> setPosition)
    {
        foreach (var item in items)
        {
            var pos =
                (int)TimelineScaleService.TimeToPixel(
                    getTime(item),
                    ScaleContext
                ) - (int)scrollIndex;

            setPosition(item, pos);
        }
    }

    void RecalculateAnomalyPositions()
    {
        foreach (var a in Anomalies)
        {
            DateTime positionTime;

            if (a.FirstSeen == a.LastSeen)
            {
                positionTime = a.FirstSeen;
            }
            else
            {
                long ticks =
                    (a.FirstSeen.Ticks +
                     a.LastSeen.Ticks) / 2;

                positionTime =
                    new DateTime(ticks);
            }

            a.Position = (int)TimelineScaleService.TimeToPixel(positionTime, ScaleContext) - (int)scrollIndex;
        }
    }



    //------------------------------------------------------------
    // Daten Laden und Initialisierung
    //------------------------------------------------------------

    // Zeitstempel Einträge erstellen
    private TimestampEntry CreateEntry(int index)
    {
        var time = CurrentTimeUnit switch
        {
            TimeUnit.Seconds => baseTime.AddSeconds(index * SecondsPerSpacing),
            TimeUnit.Minutes => baseTime.AddMinutes(index * (SecondsPerSpacing / 60.0)),
            TimeUnit.Hours => baseTime.AddHours(index * (SecondsPerSpacing / 3600.0)),
            TimeUnit.Days => baseTime.AddDays(index * (SecondsPerSpacing / 86400.0)),
            TimeUnit.Months => baseTime.AddMonths(index), // 1 Monat pro Intervall – Optional kannst du noch CurrentIntervalInMonths einführen
            TimeUnit.Years => baseTime.AddYears(index),
            _ => baseTime
        };

        return new TimestampEntry
        {
            Index = index,
            Time = time,
            Position = 0
        };
    }


    private async Task LoadFromDatabase()
    {
        var filePath = Path.Combine(FileSystem.AppDataDirectory, "history.sqlite");

        // sicherstellen, dass die Datei existiert
        if (File.Exists(filePath))
        {
            var entries = await Importer.LoadFromHistoryDatabaseAsync(filePath);
            State.AddBrowserEntries(entries);
        }
        else
        {
            Console.WriteLine("Datei nicht gefunden: " + filePath);
        }

        // Initiale Breite der beweglichen Ebene setzen
        if (State.BrowserEntries is { Count: > 0 })
        {
            // Basiszeit auf den frühesten Zeitpunkt setzen
            baseTime = State.BrowserEntries.Min(e => e.VisitTime);

            // Viewport-Breite zuerst sicherstellen!
            await UpdateViewportSizeAsync();

            // Erstes Element ermitteln
            var first = State.BrowserEntries.First();

            // Zentriere den ersten Eintrag auf dem Bildschirm
            var unitDistance = TimelineScaleService.GetUnitDistance(baseTime, first.VisitTime, CurrentTimeUnit);
            var scrollTo = InitialOffsetPx + unitDistance * spacing;
            scrollIndex = scrollTo - viewportWidth / 2;

            SummarizedEntries = SummarizeEntries(State.BrowserEntries, maxSecondsBetween: zoomLevels[currentZoomIndex].seconds); //Domänen Zusammenfassung erstellen

            // Jetzt scrollen
            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50); // Browser braucht kurz Zeit
            isProgrammaticScroll = false;

            visibleEntries.Clear();
            Refresh();
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task LoadCookieDatabase()
    {
        var filePath = Path.Combine(FileSystem.AppDataDirectory, "cookies.sqlite");

        // sicherstellen, dass die Datei existiert
        if (File.Exists(filePath))
        {
            var cookieService = new CookieImportService();
            var cookies = await cookieService.LoadFromCookieDatabaseAsync(filePath);
            State.SetBrowserCookies(cookies);
        }
        else
        {
            Console.WriteLine("Cookie-Datei nicht gefunden: " + filePath);
        }

        // Initiale Breite der Timeline setzen
        if (State.BrowserCookies is { Count: > 0 })
        {
            // Basiszeit: frühester "LastAccessed" (macht für Cookies am meisten Sinn)
            baseTime = State.BrowserCookies
                .Where(c => c.Created > DateTime.MinValue)
                .Min(c => c.Created);

            // Viewport-Breite aktualisieren
            await UpdateViewportSizeAsync();

            // Erstes Cookie — das neuste, entsprechend deiner ORDER BY last_access_utc DESC
            var first = State.BrowserCookies.First();

            // Zeitliche Distanz
            var unitDistance = TimelineScaleService.GetUnitDistance(baseTime, first.Created, CurrentTimeUnit);

            // Position berechnen
            var scrollTo = InitialOffsetPx + unitDistance * spacing;
            scrollIndex = scrollTo - viewportWidth / 2;

            // Scrollen
            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50);
            isProgrammaticScroll = false;

            visibleEntries.Clear();
            Refresh();
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task LoadAutofillDatabase()
    {
        var filePath = Path.Combine(FileSystem.AppDataDirectory, "webdata_autofill.sqlite");

        if (File.Exists(filePath))
        {
            var autofillService = new WebDataAutofillImportService();
            var entries = await autofillService.LoadAutofillAsync(filePath);
            State.SetAutofillEntries(entries);
        }
        else
        {
            Console.WriteLine("Autofill-Datei nicht gefunden: " + filePath);
        }

        // Timeline initialisieren
        if (State.AutofillEntries is { Count: > 0 })
        {
            // Basiszeit: erstes erzeugtes Datenfeld
            baseTime = State.AutofillEntries
                .Where(a => a.DateCreated > DateTime.MinValue)
                .Min(a => a.DateCreated);

            // Viewport ermitteln
            await UpdateViewportSizeAsync();

            // Erstes Element der Liste (ordnungsgemäß nach letzter Nutzung sortiert)
            var first = State.AutofillEntries.First();

            // Zeitliche Distanz berechnen
            var unitDistance = TimelineScaleService.GetUnitDistance(baseTime, first.DateCreated, CurrentTimeUnit);

            // Position bestimmen
            var scrollTo = InitialOffsetPx + unitDistance * spacing;
            scrollIndex = scrollTo - viewportWidth / 2;

            // Scrollen
            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50);
            isProgrammaticScroll = false;

            // Sichtbare Einträge neu berechnen
            visibleEntries.Clear();
            Refresh();
            await InvokeAsync(StateHasChanged);
        }
    }


    //------------------------------------------------------------
    // Domänen Zusammenfassungen
    //------------------------------------------------------------

    private List<DomainEntry> SummarizeEntries(List<BrowserHistoryEntry> entries, int maxSecondsBetween = 10)
    {
        var summarized = new List<DomainEntry>();
        DomainEntry? current = null;

        // 1) VORVERARBEITUNG: Domain-Hit-Count
        var domainCounts = entries
            .GroupBy(e => new Uri(e.Url).Host.ToLower())
            .ToDictionary(g => g.Key, g => g.Count());

        // 2) Heavy-Cluster: alle Domains mit >10 Visits
        var heavyDomains = domainCounts
            .Where(kvp => kvp.Value > 10)
            .Select(kvp => kvp.Key)
            .ToList();

        // Mapping: domain -> cluster index
        Dictionary<string, int> heavyClusterIndices = new();
        int clusterCounter = 1; // 1 = erste Linie über dem normalen Strahl

        foreach (var d in heavyDomains)
            heavyClusterIndices[d] = clusterCounter++;

        // ---- ORIGINAL Logik bleibt bestehen ----
        foreach (var entry in entries.OrderBy(e => e.VisitTime))
        {
            string domain = new Uri(entry.Url).Host.ToLower();

            bool isHeavy = heavyClusterIndices.ContainsKey(domain);

            if (isHeavy)
            {
                // Ein Heavy-Cluster erzeugt KEINE normalen „Domain-Wechsel“-Gruppen.
                // Sondern alles wird EINEM gemeinsamen Cluster zugeordnet.

                // Prüfen, ob URL eine bekannte Suchmaschine ist
                bool isSearch = searchEngines.Any(se => entry.Url.Contains(se)) &&
                                (entry.Url.Contains("/search") || entry.Url.Contains("q=") || entry.Url.Contains("?q="));

                summarized.Add(new DomainEntry
                {
                    Domain = domain,
                    Url = entry.Url,
                    VisitTime = entry.VisitTime,
                    IsDirect = entry.ReferrerUrl == null,
                    IsSearch = isSearch,

                    IsHeavyCluster = true,
                    HeavyClusterIndex = heavyClusterIndices[domain],
                });

                // Füge jeden Eintrag als SubEntry hinzu
                var cluster = summarized.First(e => e.Domain == domain && e.IsHeavyCluster);
                cluster.SubEntries.Add(entry);

                continue;
            }

            // ---- Normale Zusammenfassung ----
            if (current == null ||
                current.Domain != domain ||
                (entry.VisitTime - current.VisitTime).TotalSeconds > maxSecondsBetween)
            {

                // Prüfen, ob URL eine bekannte Suchmaschine ist
                bool isSearch = searchEngines.Any(se => entry.Url.Contains(se)) &&
                                (entry.Url.Contains("/search") || entry.Url.Contains("q=") || entry.Url.Contains("?q="));

                current = new DomainEntry
                {
                    Domain = domain,
                    Url = entry.Url,
                    VisitTime = entry.VisitTime,
                    IsDirect = entry.ReferrerUrl == null,
                    IsSearch = isSearch,
                };

                // **Ersten Eintrag direkt als SubEntry hinzufügen**
                current.SubEntries.Add(entry);

                summarized.Add(current);
            }
            else
            {
                current.SubEntries.Add(entry);
                if (entry.ReferrerUrl != null)
                    current.IsDirect = false;
            }
        }

        return summarized;
    }

    //------------------------------------------------------------
	// JavaScript Interop: Scrollen, Zoomen, Resizing
    //------------------------------------------------------------

    [JSInvokable("OnResize")] // Elemente werden Visuell dem Fenster angepasst
    public async Task OnResizeAsync()
    {
        isResizing = true;

        await UpdateViewportSizeAsync();

        Refresh();

        isResizing = false;
        StateHasChanged();
    }

    // Scroll Funktion
    [JSInvokable("OnAsyncScroll")]
    public async Task OnAsyncScroll(double scrollLeft)
    {
        if (isProgrammaticScroll || isZooming)
        {
            isProgrammaticScroll = false;
            return;
        }

        scrollIndex = scrollLeft;

        if (scrollIndex < 50000 || scrollIndex > movableLayerWidth - 50000)
        {
            double newOffset = movableLayerWidth / 2;
            int indexShift = (int)((scrollIndex - newOffset) / spacing);

            // Aktuelles ZoomLevel abrufen
            var currentZoom = zoomLevels[currentZoomIndex];
            var spacingTimeSpan = TimelineScaleService.GetTimeSpanFromZoomLevel(currentZoom);

            // Zeitbasis verschieben
            baseTime = baseTime.AddTicks(spacingTimeSpan.Ticks * indexShift);

            // Scrollposition korrigieren
            scrollIndex = scrollIndex - indexShift * spacing;

            isProgrammaticScroll = true;
            await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
            await Task.Delay(50); // Browser braucht kurz Zeit
            isProgrammaticScroll = false;

            UpdateVisibleTimestamps();
            Refresh();
            StateHasChanged();
            return;
        }

        Refresh();
        StateHasChanged();
    }

    [JSInvokable("OnZoom")]
    public async Task OnZoomAsync(string direction)
    {
        isZooming = true;

        // 1️⃣ Scrollgrenzen für aktuellen Zustand absichern
        scrollIndex = Math.Clamp(
            scrollIndex,
            0,
            Math.Max(0, movableLayerWidth - viewportWidth)
        );

        // 2️⃣ Mittelpunkt-Zeit aus aktuellem Zustand ermitteln
        double centerPx = scrollIndex + viewportWidth / 2;
        DateTime centerTime = TimelineScaleService.PixelToTime(centerPx, ScaleContext);

        // 3️⃣ Zoomstufe ändern
        if (direction == "in" && currentZoomIndex > 0)
            currentZoomIndex--;
        else if (direction == "out" && currentZoomIndex < zoomLevels.Length - 1)
            currentZoomIndex++;

        // 4️⃣ Neue Scrollposition für dieselbe Zeit berechnen
        double newCenterPx = TimelineScaleService.TimeToPixel(centerTime, ScaleContext);
        double newScrollLeft = newCenterPx - viewportWidth / 2;

        // 5️⃣ 🔥 WICHTIG: neuen Scrollwert übernehmen
        scrollIndex = Math.Clamp(
            newScrollLeft,
            0,
            Math.Max(0, movableLayerWidth - viewportWidth)
        );

        // 6️⃣ Optional: Scroll-Container synchronisieren
        isProgrammaticScroll = true;
        await JS.InvokeVoidAsync("scrollHelpers.scrollTo", scrollDivRef, scrollIndex, 0);
        await Task.Delay(1);
        isProgrammaticScroll = false;

        // 7️⃣ ALLE Pixel neu berechnen (JETZT korrekt!)
        Refresh();

        StateHasChanged();
        isZooming = false;
    }


    [JSInvokable("OnArrowRight")]
    public async Task OnArrowRightAsync()
    {
        if (currentArtifactIndex < TimelineArtifacts.Count - 1)
        {
            currentArtifactIndex++;
            await FocusArtifact(TimelineArtifacts[currentArtifactIndex]);
        }
    }

    [JSInvokable("OnArrowLeft")]
    public async Task OnArrowLeftAsync()
    {
        if (currentArtifactIndex > 0)
        {
            currentArtifactIndex--;
            await FocusArtifact(TimelineArtifacts[currentArtifactIndex]);
        }
    }

    private async Task StartArtifactResize(MouseEventArgs e)
    {
        await JS.InvokeVoidAsync(
            "artifactResize.start",
            DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public void ResizeArtifactTable(double height)
    {
        artifactTableHeight =
            Math.Max(20, Math.Min(height, 1000));

        StateHasChanged();
    }

    async Task ExpandAndFocus(DomainEntry domainEntry)
    {
        ResetSelection();

        selectedDomain = domainEntry;

        domainEntry.IsExpanded = true;
        expandedStates[domainEntry.Domain] = true;

        int index = State.BrowserEntries.FindIndex(e =>
            Math.Abs((e.VisitTime - domainEntry.VisitTime).TotalSeconds) < 1);

        if (index >= 0)
        {
            currentPivotIndex = index;
            await CenterOnEntry(index);
        }

        Refresh();

        StateHasChanged();
    }



    //------------------------------------------------------------
	// Verschiedene Hilfsmethoden
    //------------------------------------------------------------

    // zentriert Timeline um ein entry.
    private async Task CenterOnEntry(int index)
    {
        if (State.BrowserEntries == null || !State.BrowserEntries.Any())
            return;

        index = Math.Clamp(index, 0, State.BrowserEntries.Count - 1);

        currentPivotIndex = index;

        var entry = State.BrowserEntries[index];

        await CenterOnTime(entry.VisitTime);
    }

    private async Task CenterOnTime(DateTime time)
    {
        // Timeline neu auf Zeitpunkt ankern
        baseTime = time;

        // Mittelpunkt exakt auf InitialOffset
        scrollIndex = InitialOffsetPx - viewportWidth / 2;

        // Clamp
        scrollIndex = Math.Clamp(
            scrollIndex,
            0,
            Math.Max(0, movableLayerWidth - viewportWidth)
        );

        Refresh();

        await InvokeAsync(StateHasChanged);

        isProgrammaticScroll = true;

        await JS.InvokeVoidAsync(
            "scrollHelpers.scrollTo",
            scrollDivRef,
            scrollIndex,
            0
        );

        await Task.Delay(1);

        isProgrammaticScroll = false;
    }

    private void SyncFocusedArtifact(object artifact)
    {
        int index = TimelineArtifacts.FindIndex(a => a.Data == artifact);

        if (index >= 0)
        {
            currentArtifactIndex = index;
            focusedArtifact = TimelineArtifacts[index];
        }
    }

    private async Task FocusArtifact(TimelineArtifact artifact)
    {
        // NUR Fokus setzen
        focusedArtifact = artifact;

        // Panels schließen
        ResetSelection();

        switch (artifact.Type)
        {
            case ArtifactType.History:
                {
                    var entry = (BrowserHistoryEntry)artifact.Data;

                    var domain = SummarizedEntries.FirstOrDefault(d =>
                        d.SubEntries.Any(s => s == entry));

                    if (domain != null)
                    {
                        // NUR expandieren
                        domain.IsExpanded = true;
                        expandedStates[domain.Domain] = true;
                    }

                    break;
                }

            case ArtifactType.Cookie:
            case ArtifactType.UserInput:
            case ArtifactType.Extension:
            case ArtifactType.Storage:
            case ArtifactType.Anomaly:
                break;
        }

        await CenterOnTime(artifact.Time);

        Refresh();

        StateHasChanged();
    }

    async Task FocusAnomaly(AnomalyEntry anomaly)
    {
        ResetSelection();

        selectedAnomaly = anomaly;

        SyncFocusedArtifact(anomaly);

        DateTime focusTime;

        if (anomaly.FirstSeen == anomaly.LastSeen)
        {
            focusTime = anomaly.FirstSeen;
        }
        else
        {
            long ticks =
                (anomaly.FirstSeen.Ticks + anomaly.LastSeen.Ticks) / 2;

            focusTime = new DateTime(ticks);
        }

        await CenterOnTime(focusTime);

        Refresh();

        StateHasChanged();
    }

    async Task FocusHistoryFromTable(BrowserHistoryEntry entry)
    {
        ResetSelection();

        var domain = SummarizedEntries.FirstOrDefault(d =>
            d.SubEntries.Any(s => s == entry));

        if (domain != null)
        {
            domain.IsExpanded = true;
            expandedStates[domain.Domain] = true;

            selectedDomain = domain;
            selectedSubEntry = entry;

            SyncFocusedArtifact(entry);

            await CenterOnTime(entry.VisitTime);

            Refresh();

            StateHasChanged();
        }
    }

    bool IsFocused(object obj)
    {
        return focusedArtifact?.Data == obj;
    }

    string GetSeverityBackground(int severity)
    {
        return severity switch
        {
            5 => "rgba(255,45,45,0.18)",
            4 => "rgba(255,107,0,0.18)",
            3 => "rgba(255,176,0,0.18)",
            2 => "rgba(63,169,245,0.18)",
            _ => "rgba(255,255,255,0.05)"
        };
    }

    int? GetArtifactSeverity(object artifact)
    {
        var matches = Anomalies.Where(a =>
        {
            return artifact switch
            {
                BrowserHistoryEntry h =>
                    a.LinkedHistory.Contains(h),

                BrowserCookieEntry c =>
                    a.LinkedCookies.Contains(c),

                UserInputEntry i =>
                    a.LinkedInputs.Contains(i),

                BrowserExtensionEntry e =>
                    a.LinkedExtensions.Contains(e),

                StorageEntry s =>
                    a.LinkedStorage.Contains(s),

                DomainEntry d =>
                    a.TargetType == AnomalyTargetType.Domain &&
                    a.LinkedDomain == d,

                AnomalyEntry an =>
                    an == a,

                _ => false
            };
        });

        if (!matches.Any())
            return null;

        return matches.Max(a => a.Severity);
    }

    string GetArtifactStyle(object artifact)
    {
        var severity = GetArtifactSeverity(artifact);

        if (severity == null)
            return "";

        var bg = GetSeverityBackground(severity.Value);

        return $"background:{bg};";
    }

    
    int baseTop = 33; // Basislinie für normale Domains in %
    int heavyClusterSpacingPx = 20; // Abstand jeder neuen Heavy Cluster-Linie nach oben

    string GetSeverityColor(int severity) => severity switch
    {
        5 => "#ff2d2d",   // Rot – kritisch
        4 => "#ff6b00",   // Dunkelorange
        3 => "#ffb000",   // Orange
        2 => "#3fa9f5",   // Blau
        _ => "#9e9e9e"    // Grau
    };

    string GetMarkerFocusStyle(object artifact)
    {
        if (!IsFocused(artifact))
            return "";

        return @"
        transform:scale(1.4);
        transform-origin:center;
        filter:
            brightness(1.25)
            drop-shadow(0 0 6px rgba(255,255,255,0.45));
        transition:
            transform 0.12s ease,
            filter 0.12s ease;
    ";
    }

    string GetFocusedStyle(object artifact)
    {
        if (!IsFocused(artifact))
            return "";

        return @"
        transform:scale(1.6);
        transform-origin:center;
        z-index:999;
        filter:
            brightness(1.35)
            drop-shadow(0 0 6px rgba(255,255,255,0.55));
        transition:
            transform 0.12s ease,
            filter 0.12s ease;
    ";
    }

    // Y-Position der Domain in Prozent
    double GetDomainYPercent(DomainEntry domain)
    {
        if (!domain.IsHeavyCluster)
            return baseTop;

        double offsetPx = 25 + heavyClusterSpacingPx * (domain.HeavyClusterIndex - 1);
        double offsetPercent = (offsetPx / containerHeight) * 100.0;

        return Math.Round(baseTop - offsetPercent);
    }

    // Y-Position der Anomalie in Pixel
    double AnomalyYPercent => 78;


    IEnumerable<(double x, double yPercent)> GetAnomalyTargetPoints(
    AnomalyEntry anomaly)
    {
        // -------------------------------------------------
        // HISTORY / DOMAIN TARGETS
        // -------------------------------------------------

        var renderedSummaries = new HashSet<DomainEntry>();

        foreach (var h in anomaly.LinkedHistory)
        {
            var summary = SummarizedEntries.FirstOrDefault(
                d => d.SubEntries.Contains(h));

            if (summary == null)
                continue;

            double y = GetDomainYPercent(summary);

            // Expandiert → einzelne History-Ziele
            if (summary.IsExpanded)
            {
                yield return (h.Position, y);
            }
            else
            {
                // Nicht mehrfach dieselbe Summary rendern
                if (renderedSummaries.Contains(summary))
                    continue;

                renderedSummaries.Add(summary);

                yield return (summary.Position, y);
            }
        }

        // -------------------------------------------------
        // COOKIES
        // -------------------------------------------------

        foreach (var c in anomaly.LinkedCookies)
        {
            yield return (c.Position, 43);
        }

        // -------------------------------------------------
        // INPUTS
        // -------------------------------------------------

        foreach (var i in anomaly.LinkedInputs)
        {
            yield return (i.Position, 50);
        }

        // -------------------------------------------------
        // EXTENSIONS
        // -------------------------------------------------

        foreach (var e in anomaly.LinkedExtensions)
        {
            yield return (e.Position, 64);
        }

        // -------------------------------------------------
        // STORAGE
        // -------------------------------------------------

        foreach (var s in anomaly.LinkedStorage)
        {
            yield return (s.Position, 57);
        }
    }

    bool IsAnomalyConnectionVisible(AnomalyEntry anomaly)
    {
        double viewportStart = 0;
        double viewportEnd = viewportWidth;

        // Kugel sichtbar
        if (anomaly.Position >= viewportStart &&
            anomaly.Position <= viewportEnd)
            return true;

        // Deleted-History / einzelne Targets
        if (anomaly.TargetPosition >= viewportStart &&
            anomaly.TargetPosition <= viewportEnd)
            return true;

        // Domain-basierte Linien
        if (anomaly.LinkedHistory != null)
        {
            foreach (var point in GetAnomalyTargetPoints(anomaly))
            {
                // Ziel sichtbar
                if (point.x >= viewportStart &&
                    point.x <= viewportEnd)
                    return true;

                // Linie schneidet Viewport
                double minX = Math.Min(point.x, anomaly.Position);
                double maxX = Math.Max(point.x, anomaly.Position);

                if (maxX >= viewportStart &&
                    minX <= viewportEnd)
                    return true;
            }
        }

        return false;
    }


    public void Dispose()
    {
        selfRef?.Dispose();
    }
}

