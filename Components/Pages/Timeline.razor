    private void Refresh()
    {
        DomainEntries = BuildDomainEntries(State.BrowserEntries);

        foreach (var domain in DomainEntries)
        {
            foreach (var history in domain.SubEntries)
            {
                history.ParentDomain = domain;
            }
        }

        foreach (var entry in DomainEntries)
        {
            // Farbe nur einmal berechnen
            entry.RenderColor = ColorService.GetColor(entry.Url);

            // Expand-State übernehmen oder initial setzen
            if (expandedStates.TryGetValue(entry.Domain, out bool expanded))
            {
                entry.IsExpanded = expanded;
            }
            else
            {
                entry.IsExpanded = allExpanded;
                expandedStates[entry.Domain] = allExpanded;
            }
        }

        var aggregator = new UserInputAggregatorService();

        if (!UserInputs.Any()) // Nur neu bauen, wenn sich was geändert hat.
        {
            UserInputs = aggregator.Build(
                State.BrowserEntries,
                State.AutofillEntries,
                State.Favicons,
                UserInputs
            );
        }

        RecalculatePositions(
        State.BrowserEntries,
        x => x.VisitTime,
        (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            State.BrowserCookies,
            x => x.Created,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            UserInputs,
            x => x.Time,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            DomainEntries,
            x => x.VisitTime,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            State.Extensions,
            x => x.InstallTime,
            (x, pos) => x.Position = pos
        );

        RecalculatePositions(
            State.StorageEntries,
            x => x.Time,
            (x, pos) => x.Position = pos
        );

        foreach (var domain in DomainEntries)
        {
            if (!domain.SubEntries.Any())
                continue;

            domain.ClusterStartPosition =
                domain.SubEntries.First().Position;

            domain.ClusterEndPosition =
                domain.SubEntries.Last().Position;
        }

        foreach (var input in UserInputs)
            input.Relations.Clear();

        foreach (var history in State.BrowserEntries)
            history.Relations.Clear();

        foreach (var cookie in State.BrowserCookies)
            cookie.Relations.Clear();

        foreach (var ext in State.Extensions)
            ext.Relations.Clear();

        foreach (var storage in State.StorageEntries)
            storage.Relations.Clear();

        foreach (var domain in DomainEntries)
            domain.Relations.Clear();

        RelationService.BuildRelations(
            DomainEntries,
            State.BrowserCookies,
            UserInputs,
            State.Extensions,
            State.StorageEntries
        );

        AnalysisEntries = AnalysisService.Detect(
            DomainEntries,
            State.BrowserCookies,
            State.AutofillEntries,
            UserInputs,
            State.Extensions,
            State.StorageEntries,
            BlacklistDomains,
            SuspiciousDomains
        );

        RecalculateAnomalyPositions();

        InvokeAsync(StateHasChanged);

        /*RenderCache.BuildVisibleCaches(
            State.BrowserEntries,
            State.BrowserCookies,
            UserInputs,
            State.Extensions,
            State.StorageEntries,
            DomainEntries,
            AnalysisEntries,
            AnalysisFilterActive,
            viewportWidth,
            SelectedDomainFilter
        );*/

        AvailableDomains = DomainEntries
        .Select(d => d.Domain)
        .Distinct()
        .OrderBy(d => d)
        .ToList();

        VisibleDomains = DomainEntries;
        VisibleHistory = State.BrowserEntries;
        VisibleCookies = State.BrowserCookies;
        VisibleInputs = UserInputs;
        VisibleExtensions = State.Extensions;
        VisibleStorage = State.StorageEntries;
        VisibleAnomalies = AnalysisEntries;

        _ = ApplyDomainFilter();

        //BuildArtifactTimeline(FilteredAnalysisEntries);
        UpdateVisibleTimestamps();


        // Fokus auf erstes Artefakt, wenn noch nicht geschehen und Artefakte vorhanden sind
        if (!_initialFocusDone && State.BrowserEntries.Any() && TimelineArtifacts.Any())
        {
            _initialFocusDone = true;

            _ = InvokeAsync(async () =>
            {
                await Task.Yield();

                var firstHistory = TimelineArtifacts
                    .FirstOrDefault(a => a.Type == ArtifactType.History);

                if (firstHistory != null)
                {
                    await FocusArtifact(firstHistory);
                }
            });
        }

    }

    private void BuildArtifactTimeline(IEnumerable<AnalysisEntry> visibleAnalysis)
    {
        TimelineArtifacts.Clear();

        TimelineArtifacts.AddRange(
            State.BrowserEntries.Select(e => new TimelineArtifact
            {
                Time = e.VisitTime,
                Data = e,
                Type = ArtifactType.History
            })
        );

        TimelineArtifacts.AddRange(
            State.BrowserCookies.Select(c => new TimelineArtifact
            {
                Time = c.Created,
                Data = c,
                Type = ArtifactType.Cookie
            })
        );

        TimelineArtifacts.AddRange(
            UserInputs.Select(i => new TimelineArtifact
            {
                Time = i.Time,
                Data = i,
                Type = ArtifactType.UserInput
            })
        );

        TimelineArtifacts.AddRange(
            State.Extensions.Select(e => new TimelineArtifact
            {
                Time = e.InstallTime,
                Data = e,
                Type = ArtifactType.Extension
            })
        );

        TimelineArtifacts.AddRange(
            State.StorageEntries.Select(s => new TimelineArtifact
            {
                Time = s.Time,
                Data = s,
                Type = ArtifactType.Storage
            })
        );

        TimelineArtifacts.AddRange(
        visibleAnalysis.Select(a => new TimelineArtifact
        {
            Time = a.FirstSeen,
            Data = a,
            Type = ArtifactType.Anomaly
        }));

        TimelineArtifacts = TimelineArtifacts
            .OrderBy(t => t.Time)
            .ToList();
    }


