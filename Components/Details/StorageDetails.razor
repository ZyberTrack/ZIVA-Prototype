<div class="entry-details storage-details">

    <div class="entry-header">
        <span>Storage Artifact</span>
        <button class="close-btn" @onclick="OnClose">✕</button>
    </div>

    <div class="entry-content">

        <p>
            <strong>Type:</strong>
            @Data.Type
        </p>

        <p>
            <strong>Origin:</strong><br />
            @Data.Origin
        </p>

        <p>
            <strong>Timestamp:</strong><br />
            @Data.Time.ToLocalTime()
        </p>

        @if (Data.LastModified != null)
        {
            <p>
                <strong>Last Modified:</strong><br />
                @Data.LastModified.Value.ToLocalTime()
            </p>
        }

        <hr />

        <p>
            <strong>Key:</strong><br />
            @Data.Key
        </p>

        <p>
            <strong>Value:</strong>
        </p>

        <div class="storage-value">
            @Data.Value
        </div>

        @if (Data.IsSensitive)
        {
            <div class="risk-warning">
                ⚠ Sensitive / Token-like Content
            </div>
        }

        @if (Data.IsBinary)
        {
            <div class="binary-warning">
                Binary / Encoded Content detected
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Data.RawKeyHex))
        {
            <hr />

            <p><strong>Raw Key (HEX)</strong></p>

            <div class="hex-block">
                @Data.RawKeyHex
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Data.RawValueHex))
        {
            <p><strong>Raw Value (HEX)</strong></p>

            <div class="hex-block">
                @Data.RawValueHex
            </div>
        }

    </div>
</div>

@code {
    [Parameter] public StorageEntry Data { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}