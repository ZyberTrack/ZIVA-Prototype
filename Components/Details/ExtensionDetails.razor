@using ZIVA_Prototype.Components.Models.Timeline

<div class="entry-details extension-details anomaly-details"
         style="@GetSeverityStyle()">

    <div class="entry-header">
        <span>@Data.Name
            @if (Data.HighestAnomalySeverity >= 3)
            {
                <span class="severity-badge"
                      style="@GetArtifactBadgeStyle()">

                    SEV-@Data.HighestAnomalySeverity

                </span>
            }
        </span>

        <button class="close-btn"
                @onclick="OnClose">
            ✕
        </button>
    </div>

    <div class="entry-content">

        <div class="entry-row">
            <strong>Extension ID</strong><br />

            <span style="
                font-family:monospace;
                word-break:break-all;
                color:#9ecbff;">
                @Data.Id
            </span>
        </div>

        <div class="entry-row">
            <strong>Risk</strong><br />
            @Data.RiskLevel (@Data.RiskScore)
        </div>

        <div class="entry-row">
            <strong>Version</strong><br />
            @Data.Version
        </div>

        <div class="entry-row">
            <strong>Installed/Updated</strong><br />
            @Data.InstallTime.ToLocalTime()
        </div>

        @if (Data.LastFilesystemActivity != default)
        {
            <div class="entry-row">
                <strong>Last Filesystem Activity</strong><br />

                @Data.LastFilesystemActivity.ToLocalTime()
            </div>
        }

        @if (Data.LastRuntimeActivity != default)
        {
            <div class="entry-row">
                <strong>Last Runtime Activity</strong><br />

                @Data.LastRuntimeActivity.ToLocalTime()
            </div>
        }

        <div class="entry-row">
            <strong>Enabled</strong><br />
            @(Data.IsEnabled ? "Yes" : "No")
        </div>

        <div class="entry-row">
            <strong>Source</strong><br />
            @(Data.IsUnpacked
                ? "Unpacked / Developer"
                : Data.IsFromWebStore
                    ? "Chrome Web Store"
                    : "Unknown")
        </div>

        <div class="entry-row">
            <strong>Evidence</strong><br />

            @if (Data.IsInstalled)
            {
                <div>✔ Installed Extension Evidence</div>
            }

            @if (Data.HasRuntimeEvidence)
            {
                <div>✔ Runtime Activity Detected</div>
            }

            @if (Data.IsFilesystemOnly)
            {
                <div>⚠ Filesystem-only Artifact</div>
            }

            @if (Data.IsResidualArtifact)
            {
                <div>⚠ Residual / Removed Artifact</div>
            }

            @if (Data.ManifestMissing)
            {
                <div>⚠ Manifest Missing</div>
            }

            @if (!Data.HasTimestamp)
            {
                <div>⚠ No Reliable Timestamp</div>
            }
        </div>

        <div class="entry-row">
            <strong>Found In</strong>

            <ul>

                @if (Data.FoundInPreferences)
                {
                    <li>Preferences</li>
                }

                @if (Data.FoundInSecurePreferences)
                {
                    <li>Secure Preferences</li>
                }

                @if (Data.FoundInExtensionsFolder)
                {
                    <li>Extensions Folder</li>
                }

                @if (Data.FoundInRuntimeArtifacts)
                {
                    <li>Runtime Artifacts</li>
                }

                @if (Data.FoundInFilesystem)
                {
                    <li>Filesystem Scan</li>
                }

                @if (Data.FoundInHistory)
                {
                    <li>Browser History</li>
                }

            </ul>
        </div>

        @if (Data.SourceTypes.Any())
        {
            <div class="entry-row">
                <strong>Runtime Sources</strong>

                <ul>
                    @foreach (var s in Data.SourceTypes.Distinct())
                    {
                        <li>@s</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Data.InstallLocation))
        {
            <div class="entry-row">
                <strong>Install Path</strong><br />
                @Data.InstallLocation
            </div>
        }

        @if (Data.RuntimeArtifacts.Any())
        {
            <div class="entry-row">
                <strong>Runtime Artifacts</strong>

                <ul>
                    @foreach (var r in Data.RuntimeArtifacts.Take(10))
                    {
                        <li>@r</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Data.Description))
        {
            <div class="entry-row">
                <strong>Description</strong><br />
                @Data.Description
            </div>
        }

        <div class="entry-row">
            <strong>Top Findings</strong>

            <ul>
                @foreach (var f in Data.Findings
                         .OrderByDescending(x => x.Weight))
                {
                    <li style="margin-top:8px;">
                        <strong>@f.Type</strong><br />
                        @f.Description
                    </li>
                }
            </ul>
        </div>

        <div class="entry-row">
            <strong>Permissions</strong>

            <ul>
                @foreach (var p in Data.AllPermissions)
                {
                    <li>@p</li>
                }
            </ul>
        </div>

        @if (Data.ContentScripts.Any())
        {
            <div class="entry-row">
                <strong>Content Scripts</strong>

                <ul>
                    @foreach (var s in Data.ContentScripts)
                    {
                        <li>@s</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Data.BackgroundScript))
        {
            <div class="entry-row">
                <strong>Background Worker</strong><br />
                @Data.BackgroundScript
            </div>
        }

        @if (RelatedAnomalies.Any())
        {
            <div class="entry-row">
                <strong>Related Anomalies</strong><br />

                @foreach (var anomaly in RelatedAnomalies)
                {
                    <div class="linked-anomaly"
                         style="@GetAnomalyStyle(anomaly)"
                         @onclick="() => OnFocusAnomaly.InvokeAsync(anomaly)">

                        <strong>@anomaly.Type</strong>

                        <br />

                        Severity:
                        @anomaly.Severity

                        <br />

                        @(string.IsNullOrWhiteSpace(anomaly.Description)
                            ? "-"
                            : anomaly.Description)

                    </div>
                }
            </div>
        }

    </div>

</div>

@code {

    [Parameter]
    public BrowserExtensionEntry Data { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public List<AnomalyEntry> Anomalies { get; set; } = new();

    [Parameter]
    public EventCallback<AnomalyEntry> OnFocusAnomaly { get; set; }

    private List<AnomalyEntry> RelatedAnomalies =>
        Anomalies
            .Where(a => a.LinkedExtensions.Contains(Data))
            .OrderByDescending(a => a.Severity)
            .ToList();

    private string GetAnomalyStyle(AnomalyEntry anomaly)
    {
        return anomaly.Severity switch
        {
            5 => "border-left:4px solid #ff2b2b;",
            4 => "border-left:4px solid #ff7a2b;",
            3 => "border-left:4px solid #ffb52b;",
            2 => "border-left:4px solid #ffe12b;",
            _ => "border-left:4px solid #6cff6c;"
        };
    }

    private string GetSeverityStyle()
    {
        return Data.HighestAnomalySeverity switch
        {
            5 =>
                "border-top:3px solid #ff2b2b;" +
                "box-shadow:0 0 18px rgba(255,43,43,0.18);",

            4 =>
                "border-top:3px solid #ff7a2b;" +
                "box-shadow:0 0 18px rgba(255,122,43,0.16);",

            3 =>
                "border-top:3px solid #ffb52b;" +
                "box-shadow:0 0 16px rgba(255,181,43,0.14);",

            2 =>
                "border-top:3px solid #ffe12b;" +
                "box-shadow:0 0 14px rgba(255,225,43,0.12);",

            _ =>
                "border-top:3px solid #6cff6c;" +
                "box-shadow:0 0 12px rgba(108,255,108,0.10);"
        };
    }

    private string GetArtifactBadgeStyle()
    {
        return Data.HighestAnomalySeverity switch
        {
            5 => "background:#ff2b2b;",
            4 => "background:#ff7a2b;",
            3 => "background:#ffb52b;",
            2 => "background:#ffe12b; color:black;",
            _ => "background:#6cff6c; color:black;"
        };
    }
}