@using ZIVA_Prototype.Components.Models.Timeline;
@using ZIVA_Prototype.Components.Models.Enums;

<div class="entry-details anomaly-details"
     style="@GetSeverityStyle()">

    <div class="entry-header">
        <span>
            Analyse Details

            <span class="severity-badge"
                  style="@GetCategoryBadgeStyle()">
                @Data.Category
            </span>

            <span class="severity-badge"
                  style="@GetBadgeStyle()">
                SEV-@Data.Severity
            </span>
        </span>

        <button class="close-btn"
                @onclick="OnClose">
            ✕
        </button>
    </div>

    <div class="entry-content">

        <div class="entry-row">
            <strong>Category</strong><br />

            <span style="
                color:@GetCategoryColor();
                font-weight:700;">

                @Data.Category

            </span>

        </div>

        <div class="entry-row">
            <strong>Type</strong><br />

            <span style="
                color:@GetCategoryColor();
                font-weight:800;
                font-size:16px;
                letter-spacing:0.3px;">

                @Data.Type

            </span>
        </div>

        <div class="entry-row">
            <strong>Description</strong><br />
            @(string.IsNullOrWhiteSpace(Data.Description)
                ? "-"
                : Data.Description)
        </div>

        <div class="entry-row">
            <strong>Confidence</strong><br />

            <span style="
                color:#9ad1ff;
                font-weight:700;">

                @Data.Confidence%

            </span>
        </div>

        <div class="entry-row">
            <strong>Severity</strong><br />
            @Data.Severity / 5
        </div>

        <div class="entry-row">
            <strong>Occurrences</strong><br />
            @Data.Count
        </div>

        <div class="entry-row">
            <strong>First Seen</strong><br />
            @Data.FirstSeen
        </div>

        <div class="entry-row">
            <strong>Last Seen</strong><br />
            @Data.LastSeen
        </div>

        <div class="entry-row">
            <strong>Duration</strong><br />
            @((Data.LastSeen - Data.FirstSeen).ToString())
        </div>

        <div class="entry-row">
            <strong>Target Type</strong><br />
            @Data.TargetType
        </div>

        <div class="entry-row">
            <strong>Timeline Position</strong><br />
            X: @Data.Position
        </div>

        <div class="entry-row">
            <strong>Target Position</strong><br />
            X: @Math.Round(Data.TargetPosition, 1)
            <br />
            Y: @Math.Round(Data.TargetYPercent, 1)%
        </div>

        <div class="entry-row">
            <strong>URL</strong><br />
            @(string.IsNullOrWhiteSpace(Data.Url)
                ? "-"
                : Data.Url)
        </div>

        @if (Data.LinkedDomain != null)
        {
            <div class="entry-row">
                <strong>Linked Domain</strong><br />
                @Data.LinkedDomain.Domain
            </div>

            <div class="entry-row">
                <strong>Linked Visits</strong><br />
                @(Data.LinkedDomain.SubEntries?.Count ?? 0)
            </div>

            <div class="entry-row">
                <strong>Domain Expanded</strong><br />
                @(Data.LinkedDomain.IsExpanded ? "Yes" : "No")
            </div>

            <div class="entry-row">
                <strong>Heavy Cluster</strong><br />
                @(Data.LinkedDomain.IsHeavyCluster ? "Yes" : "No")
            </div>
        }

        @if (Data.Evidence.Any())
        {
            <div class="entry-row">
                <strong>Evidence</strong>

                <ul style="
                    margin-top:10px;
                    padding-left:18px;">

                    @foreach (var evidence in Data.Evidence.Distinct())
                    {
                        <li style="
                            margin-top:6px;
                            color:#d6e4f0;
                            line-height:1.45;">

                            @evidence

                        </li>
                    }
                </ul>
            </div>
        }

        @if (Data.LinkedExtensions.Any())
        {
            <div class="entry-row">
                <strong>Linked Extensions</strong>

                <ul style="
                    margin-top:10px;
                    padding-left:18px;">

                    @foreach (var ext in Data.LinkedExtensions.Distinct())
                    {
                        <li style="margin-top:8px;">

                            <span style="
                                color:@GetSeverityTextColor();
                                font-weight:700;">

                                @ext.Name

                            </span>

                            <br />

                            <span style="
                                font-size:12px;
                                opacity:0.75;">

                                @ext.Id

                            </span>

                        </li>
                    }
                </ul>
            </div>
        }

        @if (Data.LinkedInputs.Any())
        {
            <div class="entry-row">
                <strong>Linked Inputs</strong>

                <ul style="
                    margin-top:10px;
                    padding-left:18px;">

                    @foreach (var input in Data.LinkedInputs.Distinct())
                    {
                        <li style="margin-top:8px;">

                            <span style="
                                color:@GetSeverityTextColor();
                                font-weight:700;">

                                @input.Type

                            </span>

                            <br />

                            @input.Value

                        </li>
                    }
                </ul>
            </div>
        }

        @if (Data.LinkedCookies.Any())
        {
            <div class="entry-row">
                <strong>Linked Cookies</strong>

                <ul style="
                    margin-top:10px;
                    padding-left:18px;">

                    @foreach (var cookie in Data.LinkedCookies.Distinct())
                    {
                        <li style="margin-top:8px;">

                            <span style="
                                color:@GetSeverityTextColor();
                                font-weight:700;">

                                @cookie.Name

                            </span>

                            <br />

                            @cookie.Host

                        </li>
                    }
                </ul>
            </div>
        }

    </div>

</div>

@code {

    [Parameter]
    public AnalysisEntry Data { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string GetSeverityStyle()
    {
        return Data.Severity switch
        {
            5 =>
                "border-top:3px solid #ff2b2b;" +
                "box-shadow:0 0 18px rgba(255,43,43,0.18);",

            4 =>
                "border-top:3px solid #ff7a2b;" +
                "box-shadow:0 0 18px rgba(255,122,43,0.16);",

            3 =>
                "border-top:3px solid #ffb52b;" +
                "box-shadow:0 0 16px rgba(255,181,43,0.14);",

            2 =>
                "border-top:3px solid #ffe12b;" +

                "box-shadow:0 0 14px rgba(255,225,43,0.12);",

            _ =>
                "border-top:3px solid #6cff6c;" +
                "box-shadow:0 0 12px rgba(108,255,108,0.10);"
        };
    }

    private string GetCategoryBadgeStyle()
    {
        return Data.Category switch
        {
            AnalysisCategory.Information =>
                "background:#1E88E5;",

            AnalysisCategory.Warning =>
                "background:#F9A825;color:black;",

            AnalysisCategory.Anomaly =>
                "background:#C62828;",

            _ =>
                "background:#757575;"
        };
    }

    private string GetSeverityBadgeStyle()
    {
        return Data.Severity switch
        {
            5 => "background:#C62828;",
            4 => "background:#E64A19;",
            3 => "background:#FB8C00;",
            2 => "background:#FDD835;color:black;",
            _ => "background:#43A047;"
        };
    }

    private string GetCategoryColor()
    {
        return Data.Category switch
        {
            AnalysisCategory.Information => "#42A5F5",
            AnalysisCategory.Warning => "#FFD54F",
            AnalysisCategory.Anomaly => "#EF5350",

            _ => "#E0E0E0"
        };
    }

    private string GetBadgeStyle()
    {
        return Data.Severity switch
        {
            5 => "background:#ff2b2b;",
            4 => "background:#ff7a2b;",
            3 => "background:#ffb52b;",
            2 => "background:#ffe12b; color:black;",
            _ => "background:#6cff6c; color:black;"
        };
    }

    private string GetSeverityTextColor()
    {
        return Data.Severity switch
        {
            5 => "#ff4b4b",
            4 => "#ff8a3d",
            3 => "#ffc14d",
            2 => "#ffe75c",
            _ => "#7dff7d"
        };
    }
}