@using ZIVA_Prototype.Components.Models.Timeline
@using ZIVA_Prototype.Services

<div class="entry-details">

    <div class="entry-header">
        <span>Cookie: @Data.Name</span>

        <button class="close-btn"
                @onclick="OnClose">
            ✕
        </button>
    </div>

    <div class="entry-content">

        <div class="entry-row">
            <strong>Host</strong><br />
            @Data.Host
        </div>

        <div class="entry-row">
            <strong>Name</strong><br />
            @Data.Name
        </div>

        <div class="entry-row">
            <strong>Created</strong><br />
            @Data.Created
        </div>

        <div class="entry-row">
            <strong>Last Accessed</strong><br />
            @Data.LastAccessed
        </div>

        <div class="entry-row">
            <strong>Expires</strong><br />
            @Data.Expires
        </div>

        @if (RelatedAnomalies.Any())
        {
            <div class="entry-row">
                <strong>Related Anomalies</strong><br />

                @foreach (var anomaly in RelatedAnomalies)
                {
                    <div class="linked-anomaly"
                         style="@GetAnomalyStyle(anomaly)"
                         @onclick="() => OnFocusAnomaly.InvokeAsync(anomaly)">

                        <strong>@anomaly.Type</strong>

                        <br />

                        Severity:
                        @anomaly.Severity

                        <br />

                        @(string.IsNullOrWhiteSpace(anomaly.Description)
                            ? "-"
                            : anomaly.Description)

                    </div>
                }
            </div>
        }

    </div>

</div>

@code {

    [Parameter]
    public BrowserCookieEntry Data { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public List<AnomalyEntry> Anomalies { get; set; } = new();

    [Parameter]
    public EventCallback<AnomalyEntry> OnFocusAnomaly { get; set; }

    private List<AnomalyEntry> RelatedAnomalies =>
        Anomalies
            .Where(a => a.LinkedCookies.Contains(Data))
            .OrderByDescending(a => a.Severity)
            .ToList();

    private string GetAnomalyStyle(AnomalyEntry anomaly)
    {
        return anomaly.Severity switch
        {
            5 => "border-left:4px solid #ff2b2b;",
            4 => "border-left:4px solid #ff6b2b;",
            3 => "border-left:4px solid #ffb52b;",
            2 => "border-left:4px solid #ffd92b;",
            _ => "border-left:4px solid #6cff6c;"
        };
    }
}