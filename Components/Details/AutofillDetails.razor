@using ZIVA_Prototype.Components.Models.Timeline;
@using ZIVA_Prototype.Components.Models.Enums;

<div class="entry-details">

    <div class="entry-header">
        <span>User Input Details</span>

        <button class="close-btn"
                @onclick="OnClose">
            ✕
        </button>
    </div>

    <div class="entry-content">

        <p>
            <strong>Type:</strong>
            @GetTypeLabel(Data.Type)
        </p>

        <p>
            <strong>Value:</strong>
            @(string.IsNullOrWhiteSpace(Data.Value)
                ? "-"
                : Data.Value)
        </p>

        <p>
            <strong>Timestamp:</strong>
            @Data.Time
        </p>

    </div>

</div>

@code {

    [Parameter]
    public UserInputEntry Data { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string GetTypeLabel(
        UserInputType type)
    {
        return type switch
        {
            UserInputType.SearchQuery =>
                "Search Query",

            UserInputType.Autofill =>
                "Autofill Data",

            UserInputType.Favicon =>
                "Favicon Artifact",

            _ =>
                type.ToString()
        };
    }
}