@using ZIVA_Prototype.Components.Models.Timeline;
@using ZIVA_Prototype.Components.Models.Enums;

@if (Data != null)
{

    <div class="entry-details anomaly-details"
         style="@GetSeverityStyle()">

        <div class="entry-header">

            <span>
                User Input Details

                @if (Data.HighestAnomalySeverity >= 3)
                {
                    <span class="severity-badge"
                          style="@GetArtifactBadgeStyle()">

                        SEV-@Data.HighestAnomalySeverity

                    </span>
                }

            </span>

            <button class="close-btn"
                    @onclick="OnClose">
                ✕
            </button>

        </div>

        <div class="entry-content">

            <div class="entry-row">
                <strong>Type</strong><br />
                @GetTypeLabel(Data.Type)
            </div>

            <div class="entry-row">
                <strong>Value</strong><br />
                @(string.IsNullOrWhiteSpace(Data.Value)
                    ? "-"
                    : Data.Value)
            </div>

            <div class="entry-row">
                <strong>Timestamp</strong><br />
                @Data.Time
            </div>

            @if (Data.LinkedHistory != null)
            {
                <div class="entry-row">
                    <strong>Originating History Entry</strong><br />

                    <div>
                        <strong>Visited:</strong>
                        @Data.LinkedHistory.VisitTime
                    </div>

                    <div style="margin-top:4px; word-break:break-word;">
                        <strong>URL:</strong><br />
                        @Data.LinkedHistory.Url
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Data.LinkedHistory.ReferrerUrl))
                    {
                        <div style="margin-top:4px; word-break:break-word;">
                            <strong>Referrer:</strong><br />
                            @Data.LinkedHistory.ReferrerUrl
                        </div>
                    }
                </div>
            }

            @if (RelatedAnomalies.Any())
            {
                <div class="entry-row">
                    <strong>Related Anomalies</strong><br />

                    @foreach (var anomaly in RelatedAnomalies)
                    {
                        <div class="linked-anomaly"
                             style="@GetAnomalyStyle(anomaly)"
                             @onclick="() => OnFocusAnomaly.InvokeAsync(anomaly)">

                            <strong>@anomaly.Type</strong>

                            <br />

                            Severity:
                            @anomaly.Severity

                            <br />

                            @(string.IsNullOrWhiteSpace(anomaly.Description)
                                ? "-"
                                : anomaly.Description)

                        </div>
                    }
                </div>
            }

        </div>

    </div>
}

@code {

    [Parameter]
    public UserInputEntry? Data { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public List<AnalysisEntry> AnalysisEntries { get; set; } = new();

    [Parameter]
    public EventCallback<AnalysisEntry> OnFocusAnomaly { get; set; }

    private List<AnalysisEntry> RelatedAnomalies =>
        Data == null
            ? new()
            : AnalysisEntries
                .Where(a =>
                    a.LinkedInputs != null &&
                    a.LinkedInputs.Contains(Data))
                .OrderByDescending(a => a.Severity)
                .ToList();

    private string GetAnomalyStyle(AnalysisEntry anomaly)
    {
        return anomaly.Severity switch
        {
            5 => "border-left:4px solid #ff2b2b;",
            4 => "border-left:4px solid #ff7a2b;",
            3 => "border-left:4px solid #ffb52b;",
            2 => "border-left:4px solid #ffe12b;",
            _ => "border-left:4px solid #6cff6c;"
        };
    }

    private string GetSeverityStyle()
    {
        if (Data == null)
            return "";

        return Data.HighestAnomalySeverity switch
        {
            5 =>
                "border-top:3px solid #ff2b2b;" +
                "box-shadow:0 0 18px rgba(255,43,43,0.18);",

            4 =>
                "border-top:3px solid #ff7a2b;" +
                "box-shadow:0 0 18px rgba(255,122,43,0.16);",

            3 =>
                "border-top:3px solid #ffb52b;" +
                "box-shadow:0 0 16px rgba(255,181,43,0.14);",

            2 =>
                "border-top:3px solid #ffe12b;" +
                "box-shadow:0 0 14px rgba(255,225,43,0.12);",

            _ =>
                "border-top:3px solid #6cff6c;" +
                "box-shadow:0 0 12px rgba(108,255,108,0.10);"
        };
    }

    private string GetArtifactBadgeStyle()
    {
        if (Data == null)
            return "";

        return Data.HighestAnomalySeverity switch
        {
            5 => "background:#ff2b2b;",
            4 => "background:#ff7a2b;",
            3 => "background:#ffb52b;",
            2 => "background:#ffe12b; color:black;",
            _ => "background:#6cff6c; color:black;"
        };
    }

    private string GetTypeLabel(UserInputType type)
    {
        return type switch
        {
            UserInputType.SearchQuery => "Search Query",
            UserInputType.Autofill => "Autofill Data",
            UserInputType.Favicon => "Favicon Artifact",
            _ => type.ToString()
        };
    }
}